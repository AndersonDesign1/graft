# Graft environment. Copy to .env (git-ignored) and fill in.

# --- Database (Postgres) ---
# Default dev: Neon (managed). Create one with:
#   npx neonctl projects create --name graft --region-id aws-eu-central-1 --org-id <org>
# Self-host alternative (docker compose): postgres://graft:graft@localhost:5432/graft
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Object storage (S3-compatible) ---
# Default: Cloudflare R2. Self-host alternative: MinIO (docker compose) at http://localhost:9000
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=graft-assets
