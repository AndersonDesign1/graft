# Graft local development environment
# Copy to .env and adjust as needed. Values match docker-compose.yml defaults.

# Postgres (content index + operational data)
DATABASE_URL=postgres://graft:graft@localhost:5432/graft

# S3-compatible object storage (assets) — MinIO in local dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=graft
S3_SECRET_KEY=graftsecret
S3_BUCKET=graft-assets
