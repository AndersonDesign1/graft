{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Silence TS 6 deprecations that tooling still injects (e.g. tsup's DTS
    // path sets baseUrl). Typechecking is TypeScript 7 native (`tsc`); the
    // `typescript` package is @typescript/typescript6 for the JS API only.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // Explicit — TS 7 defaults `types` to [] (no auto @types/*).
    "types": ["node"]
  }
}
