{
  "name": "@usegraft/cli",
  "version": "1.0.0-beta.0",
  "description": "The graft CLI: scaffold, compile authored content, serve the runtime, and split your database credentials.",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "cms",
    "content",
    "graft",
    "headless-cms",
    "mcp",
    "postgres",
    "scaffolding",
    "static-site",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/cli"
  },
  "bin": {
    "graft": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/assets": "workspace:*",
    "@usegraft/auth": "workspace:*",
    "@usegraft/compiler": "workspace:*",
    "@usegraft/content-api": "workspace:*",
    "@usegraft/content-migrations": "workspace:*",
    "@usegraft/contracts": "workspace:*",
    "@usegraft/core": "workspace:*",
    "@usegraft/db": "workspace:*",
    "@usegraft/mcp": "workspace:*",
    "@usegraft/mdx-safety": "workspace:*",
    "@usegraft/registry": "workspace:*",
    "@usegraft/studio": "workspace:*",
    "jiti": "^2.4.0"
  },
  "devDependencies": {
    "@usegraft/sdk-core": "workspace:*"
  },
  "engines": {
    "node": ">=22.16"
  }
}
