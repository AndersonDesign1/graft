{
  "name": "@usegraft/sdk-core",
  "version": "1.0.0-beta.1",
  "description": "Framework-agnostic typed read client over the Graft content index, plus the cache-tag contract.",
  "keywords": [
    "agent",
    "ai",
    "cache-tags",
    "cms",
    "content-api",
    "graft",
    "headless-cms",
    "mcp",
    "sdk",
    "typed-client",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/sdk-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/db.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/db.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "@usegraft/core": "workspace:*"
  },
  "devDependencies": {
    "@usegraft/compiler": "workspace:*",
    "@usegraft/db": "workspace:*"
  },
  "peerDependencies": {
    "@usegraft/db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@usegraft/db": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
