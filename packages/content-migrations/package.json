{
  "name": "@usegraft/content-migrations",
  "version": "1.0.0-beta.1",
  "description": "Codemod-style transforms for authored content when the schema changes.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "codemod",
    "content",
    "graft",
    "headless-cms",
    "mcp",
    "migrations",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/content-migrations"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "@usegraft/core": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "engines": {
    "node": ">=22.16"
  }
}
