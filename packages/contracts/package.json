{
  "name": "@usegraft/contracts",
  "version": "1.0.0-beta.0",
  "description": "Shared error codes and introspection schemas: the vocabulary every Graft package speaks.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "errors",
    "graft",
    "headless-cms",
    "introspection",
    "mcp",
    "schemas",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.16"
  }
}
