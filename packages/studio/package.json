{
  "name": "@usegraft/studio",
  "version": "1.0.0-beta.2",
  "description": "Graft's optional editing UI. Headless-first: every operation also exists on MCP and the CLI.",
  "keywords": [
    "admin-ui",
    "agent",
    "ai",
    "cms",
    "editor",
    "graft",
    "headless-cms",
    "mcp",
    "openapi",
    "studio",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/studio"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panels": {
      "types": "./dist/panels-entry.d.ts",
      "import": "./dist/panels-entry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:ui",
    "build:lib": "node ./scripts/clean-lib.mjs && tsup",
    "build:ui": "vite build",
    "dev": "tsup --watch",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean:lib": "node ./scripts/clean-lib.mjs"
  },
  "dependencies": {
    "@usegraft/assets": "workspace:*",
    "@usegraft/compiler": "workspace:*",
    "@usegraft/contracts": "workspace:*",
    "@usegraft/core": "workspace:*",
    "@usegraft/db": "workspace:*",
    "@usegraft/mdx-safety": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.22.1",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@usegraft/tokens": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "cmdk": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui-components/react": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
