{
  "name": "@graft/studio",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panels": {
      "types": "./dist/panels-entry.d.ts",
      "import": "./dist/panels-entry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:ui",
    "build:lib": "node ./scripts/clean-lib.mjs && tsup",
    "build:ui": "vite build",
    "dev": "tsup --watch",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "clean:lib": "node ./scripts/clean-lib.mjs"
  },
  "dependencies": {
    "@graft/compiler": "workspace:*",
    "@graft/contracts": "workspace:*",
    "@graft/core": "workspace:*",
    "@graft/db": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@graft/tokens": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.22.0",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cmdk": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui-components/react": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
