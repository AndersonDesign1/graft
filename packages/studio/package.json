{
  "name": "@graft/studio",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panels": {
      "types": "./dist/panels-entry.d.ts",
      "import": "./dist/panels-entry.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:ui",
    "build:lib": "tsup src/index.ts src/panels-entry.ts --format esm --dts --clean --external react --external react/jsx-runtime --external react-dom --external react-dom/client",
    "build:ui": "vite build",
    "dev": "tsup src/index.ts src/panels-entry.ts --format esm --watch --external react --external react/jsx-runtime --external react-dom --external react-dom/client",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@graft/compiler": "workspace:*",
    "@graft/contracts": "workspace:*",
    "@graft/core": "workspace:*",
    "@graft/db": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
