{
  "name": "@usegraft/content-api",
  "version": "1.0.0-beta.1",
  "description": "A versioned read-only HTTP transport for Graft's authored content index.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "content-api",
    "graft",
    "headless-cms",
    "http",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/content-api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*"
  },
  "devDependencies": {
    "@usegraft/db": "workspace:*"
  },
  "engines": {
    "node": ">=22.16"
  }
}
