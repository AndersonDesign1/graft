{
  "name": "@usegraft/auth",
  "version": "0.2.0",
  "description": "Turn a request into a scoped actor by verifying bearer JWTs against trusted OIDC issuers. Graft verifies identity, it does not mint it.",
  "keywords": [
    "agent",
    "ai",
    "auth",
    "better-auth",
    "cms",
    "graft",
    "headless-cms",
    "jwt",
    "mcp",
    "oidc",
    "scopes",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "@usegraft/core": "workspace:*",
    "jose": "^6.0.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
