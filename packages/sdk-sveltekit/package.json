{
  "name": "@usegraft/sdk-sveltekit",
  "version": "1.0.0-beta.9",
  "description": "SvelteKit adapter: typed content reads and endpoint mounts over Graft's stateless handlers.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "graft",
    "headless-cms",
    "mcp",
    "svelte",
    "sveltekit",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/sdk-sveltekit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "svelte": "./dist/mdx/index.js",
      "import": "./dist/mdx/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean && node scripts/copy-svelte.mjs",
    "dev": "node scripts/copy-svelte.mjs && tsup src/index.ts src/server.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "@usegraft/db": "workspace:*",
    "@usegraft/mdx-safety": "workspace:*",
    "@usegraft/sdk-core": "workspace:*",
    "mdast-util-mdx-jsx": "^3.2.0",
    "property-information": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@usegraft/core": "workspace:*",
    "svelte": "5.57.3"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
