{
  "name": "@usegraft/assets",
  "version": "0.2.0",
  "description": "S3-compatible object storage for binary assets: Cloudflare R2, MinIO, Tigris.",
  "keywords": [
    "agent",
    "ai",
    "assets",
    "cms",
    "graft",
    "headless-cms",
    "mcp",
    "minio",
    "r2",
    "s3",
    "storage",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/assets"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "engines": {
    "node": ">=22.16"
  }
}
