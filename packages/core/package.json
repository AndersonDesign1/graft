{
  "name": "@usegraft/core",
  "version": "1.0.0-beta.1",
  "description": "Schema and typed functions as owned code: defineCollection, field, defineFunction.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "content-modeling",
    "graft",
    "headless-cms",
    "mcp",
    "schema",
    "typed-functions",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@usegraft/db": "workspace:*"
  },
  "peerDependencies": {
    "@usegraft/db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@usegraft/db": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16"
  }
}
