{
  "name": "@usegraft/mdx-safety",
  "version": "1.0.0-beta.0",
  "description": "Refuse executable MDX before it is stored or rendered. MDX is code, and rendering evaluates it on the server.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "content-security",
    "graft",
    "headless-cms",
    "mcp",
    "mdx",
    "sandbox",
    "security",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/mdx-safety"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/contracts": "workspace:*",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
