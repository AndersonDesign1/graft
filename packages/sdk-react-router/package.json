{
  "name": "@usegraft/sdk-react-router",
  "version": "1.0.0-beta.9",
  "description": "React Router v7 adapter: typed content reads and loader/action mounts over Graft's stateless handlers.",
  "keywords": [
    "agent",
    "ai",
    "cms",
    "graft",
    "headless-cms",
    "mcp",
    "react",
    "react-router",
    "remix",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/sdk-react-router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "import": "./dist/mdx.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/mdx.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/server.ts src/mdx.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@usegraft/db": "workspace:*",
    "@usegraft/mdx-safety": "workspace:*",
    "@usegraft/sdk-core": "workspace:*",
    "@usegraft/sdk-react": "workspace:*"
  },
  "devDependencies": {
    "@usegraft/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
