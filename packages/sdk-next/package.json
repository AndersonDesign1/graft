{
  "name": "@graft/sdk-next",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/next-config.d.ts",
      "import": "./dist/next-config.js",
      "default": "./dist/next-config.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/next-config.ts --format esm --dts --clean --external react --external react/jsx-runtime --external next",
    "dev": "tsup src/index.ts src/next-config.ts --format esm --watch --external react --external react/jsx-runtime --external next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@graft/sdk-core": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0"
  }
}
