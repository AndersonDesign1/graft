{
  "name": "@usegraft/sdk-next",
  "version": "0.1.1",
  "description": "Next.js App Router adapter: typed content reads in Server Components, cache-tag invalidation, and real MDX rendering.",
  "keywords": [
    "agent",
    "ai",
    "app-router",
    "cms",
    "graft",
    "headless-cms",
    "mcp",
    "mdx",
    "nextjs",
    "react",
    "rsc",
    "typescript"
  ],
  "homepage": "https://github.com/AndersonDesign1/graft#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndersonDesign1/graft.git",
    "directory": "packages/sdk-next"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/next-config.d.ts",
      "import": "./dist/next-config.js",
      "default": "./dist/next-config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/next-config.ts --format esm --dts --clean --external react --external react/jsx-runtime --external next",
    "dev": "tsup src/index.ts src/next-config.ts --format esm --watch --external react --external react/jsx-runtime --external next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@usegraft/mdx-safety": "workspace:*",
    "@usegraft/sdk-core": "workspace:*",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.0.0",
    "@usegraft/core": "workspace:*",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
