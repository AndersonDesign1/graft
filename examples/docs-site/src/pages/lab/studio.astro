---
/**
 * The Studio page. Its own shape: the live app is the hero at full size,
 * the middle is four real screens of a working day, and the roles climb
 * like a staircase.
 */
import Command from "../../components/lab/Command.astro";
import Branching from "../../components/lab/Branching.astro";
import FaqList from "../../components/lab/FaqList.astro";
import Gate from "../../components/lab/Gate.astro";
import Rings from "../../components/lab/Rings.astro";
import Shot from "../../components/lab/Shot.astro";
import StudioFrame from "../../components/lab/StudioFrame.astro";
import Lab from "../../layouts/Lab.astro";

const day = [
  { name: "list", title: "Find it", body: "Every page in one list. Search it, filter drafts, or sort it the way your site does.", alt: "Studio's list of documentation pages with a search field and a drafts filter." },
  { name: "write", title: "Write it", body: "A form for the page's details and a rich text editor for the rest.", alt: "Studio's editor with a page's fields and its content." },
  { name: "changes", title: "Review it", body: "See exactly what changed, line by line, before anyone publishes.", alt: "Studio showing the lines removed and added in a page." },
  { name: "history", title: "Undo it", body: "Open a page's history and bring back any earlier version as a draft.", alt: "Studio's history panel listing earlier versions of a page." },
] as const;
const saves = [
  { who: "Content in Git", title: "Publish saves to your repository", body: "Changes are saved to your repository. On GitHub, a contributor's work becomes a pull request for an editor to merge." , link: "/docs/studio-hosting", label: "Read about hosting on GitHub"},
  { who: "Content in the database", title: "Publish goes live at once", body: "Editors publish with no rebuild and no GitHub setup. Developers can still pull the content into files.", link: "/docs/content-in-the-database", label: "Read about content in the database" },
];
const questions = [
  { q: "Do I have to use Studio?", a: "No. Studio is optional. Everything it does can also be done from the command line or by an agent, so a team of developers can skip it." },
  { q: "Does Studio need a database?", a: "Not to edit content. Without one, Studio still finds, edits and saves your pages. Sign-in for a team, approvals and preview branches need Postgres." },
  { q: "Who can sign in?", a: "On your own computer, nobody needs to. On a server, people sign in with an email and password, GitHub, Google or your single sign-on, and an admin invites the rest." },
  { q: "Can agents and editors work at the same time?", a: "Yes. An agent's work arrives as drafts in the same place an editor's does, and waits for someone who can publish." },
  { q: "What happens after I publish?", a: "Your site updates. If it needs a rebuild, add a deploy hook in Settings and Studio calls it after every publish." },
];
const roles = [
  { name: "Viewer", can: "Reads everything" },
  { name: "Contributor", can: "Writes drafts and sends them for review" },
  { name: "Editor", can: "Publishes" },
  { name: "Admin", can: "Approves deletes and invites people" },
];
---

<Lab
  title="Graft Studio"
  description="An editor for people who would rather not edit files: find, create, edit and publish content in a browser."
  variant="page"
  theme="system"
>
  <section class="screen hero studio-hero" data-enter>
    <div class="wrap studio-hero-grid">
      <div class="center-copy">
        <h1 class="h1 w-h1">The editor your content team already knows</h1>
        <p class="lead">
          Studio is the part of Graft your editors use. Lists of content, a rich text editor,
          drafts and publish, in a browser, with no code to touch.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/lab/start">Get started</a>
          <a class="btn btn-ghost" href="/docs/studio">Read about Studio</a>
        </div>
      </div>
      <div class="tray studio-hero-tray" data-peel>
        <Rings cx={50} cy={6} seed={52} rings={44} />
        <StudioFrame route="/c/docs/getting-started" />
      </div>
    </div>
  </section>

  <section class="screen" id="day">
    <div class="wrap day">
      <h2 class="h2" data-reveal><span>A working day in Studio</span></h2>
      <div class="day-grid">
        {
          day.map((item) => (
            <article class="day-item">
              <div class="day-text" data-reveal>
                <h3 class="h3">{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="tray day-tray" data-peel>
                <Shot name={item.name} alt={item.alt} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen" id="media">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Your images and files, in one library</h2>
        <p class="lead">
          Upload images and PDFs, search them by name or description, and see which pages use each
          one before you change it.
        </p>
        <ul class="points">
          <li>Write the description once, where the file lives</li>
          <li>A file in use cannot be deleted by accident</li>
          <li>Files are stored in your own bucket</li>
        </ul>
        <a class="link" href="/docs/assets">Read about images and files</a>
      </div>
      <div class="tray split-visual media-tray" data-peel>
        <div class="media-fan" aria-hidden="true">
          {
            [0, 1, 2].map((n) => (
              <svg class="fan-card" style={`--n:${n}`} viewBox="0 0 120 90">
                <rect class="art-card" x="0.5" y="0.5" width="119" height="89" rx="8" />
                <path class="art-line" d="m12 72 26-28 20 20 14-14 36 26" />
                <circle class="art-line" cx="88" cy="26" r="9" />
              </svg>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="screen screen-short" id="bulk">
    <div class="wrap run">
      <div class="closing-cards">
        <div class="closing-card">
          <p class="who">Many pages at once</p>
          <h3 class="h3">Change one field on fifty pages</h3>
          <p>
            Select the pages, choose the field, set its value. Each one is saved as a draft, so
            nothing changes on your site until you publish.
          </p>
        </div>
        <div class="closing-card">
          <p class="who">What is waiting for you</p>
          <h3 class="h3">One inbox for every decision</h3>
          <p>
            Changes sent for review and requests from agents land in the inbox. The sidebar shows
            how many are waiting.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="screen" id="roles">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Everyone gets the access they need</h2>
        <p class="lead">
          Invite people by email. Each role can do everything the one before it can, and one thing
          more.
        </p>
        <a class="link" href="/docs/studio-hosting">Read about hosting Studio for a team</a>
      </div>
      <ol class="split-visual stair" data-reveal>
        {
          roles.map((role, i) => (
            <li style={`--step:${i}`}>
              <span class="stair-name">{role.name}</span>
              <span class="stair-can">{role.can}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="screen screen-short" id="saves">
    <div class="wrap run">
      <h2 class="h2" data-reveal><span>Publish the way your site works</span></h2>
      <div class="closing-cards">
        {
          saves.map((item) => (
            <div class="closing-card">
              <p class="who">{item.who}</p>
              <h3 class="h3">{item.title}</h3>
              <p>{item.body}</p>
              <a class="link" href={item.link}>{item.label}</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen screen-short" id="run">
    <div class="wrap run">
      <h2 class="h2" data-reveal><span>Two ways to run it</span></h2>
      <div class="closing-cards">
        <div class="closing-card">
          <p class="who">On your own computer</p>
          <h3 class="h3">Open it next to your site</h3>
          <p>One command opens Studio on your project. Saving makes a commit in Git.</p>
          <Command command="graft studio" />
        </div>
        <div class="closing-card">
          <p class="who">For your team</p>
          <h3 class="h3">Host it and sign in</h3>
          <p>Run it on a server. Editors sign in with an email, GitHub, Google or your single sign-on.</p>
          <Command command="graft serve --studio" />
        </div>
      </div>
    </div>
  </section>

  <Branching />
  <Gate />
  <FaqList heading="Questions about Studio" group="studio-faq" items={questions} />
</Lab>
