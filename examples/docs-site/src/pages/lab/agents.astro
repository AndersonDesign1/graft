---
/**
 * The Agents page. Its own shape: the exchange is the hero, and the middle
 * of the page is a wall of every tool an agent gets, in plain words.
 */
import Command from "../../components/lab/Command.astro";
import DayOne from "../../components/lab/DayOne.astro";
import Gate from "../../components/lab/Gate.astro";
import Mark from "../../components/lab/Mark.astro";
import Rings from "../../components/lab/Rings.astro";
import Transcript from "../../components/lab/Transcript.astro";
import { agents } from "../../components/lab/agents";
import Lab from "../../layouts/Lab.astro";

const tools = [
  {
    group: "Read",
    items: [
      ["get_content", "Open one page"],
      ["list_content", "List what a collection holds"],
      ["search_content", "Search all your content"],
      ["list_collections", "See the kinds of content you have"],
      ["list_branches", "See your preview branches"],
    ],
  },
  {
    group: "Write",
    items: [
      ["write_content", "Create or edit a page"],
      ["put_asset", "Upload an image or a file"],
      ["delete_content", "Ask to delete a page"],
      ["run_function", "Run one of your functions"],
    ],
  },
  {
    group: "Understand",
    items: [
      ["describe_schema", "Read your content model"],
      ["describe_function", "See what a function needs"],
      ["explain_error", "Get the fix for an error"],
      ["list_registry", "See features it can add"],
      ["list_compilations", "See what each build changed"],
    ],
  },
  {
    group: "Stay in bounds",
    items: [
      ["list_approvals", "See what is waiting for a person"],
      ["list_functions", "See what it is allowed to run"],
      ["list_packages", "See what is installed"],
    ],
  },
];
const steps = [
  { title: "Add Graft to your agent", body: "One entry in your agent's MCP settings. It is the same for every agent." },
  { title: "Ask in plain words", body: "\"Add a pricing page.\" The agent reads your content model and writes the page." },
  { title: "Review what it did", body: "Every change is a file in Git. Read it, undo it, or let it ship." },
];
---

<Lab
  title="Graft for agents"
  description="What an AI agent can do in a Graft project, how it connects, and the limits that keep your content safe."
  variant="page"
  theme="system"
>
  <section class="screen hero" data-enter>
    <div class="wrap split split-hero">
      <div class="split-text">
        <h1 class="h1 w-h1">A CMS your agent can run</h1>
        <p class="lead">
          Connect the agent you already use. It reads your content model, writes and edits your
          pages, and asks a person before it deletes anything.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/docs/connecting-agents">Connect an agent</a>
          <Command command="graft mcp" quiet />
        </div>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={20} cy={78} seed={11} />
        <Transcript />
      </div>
    </div>
  </section>

  <section class="screen" id="tools">
    <div class="wrap wall">
      <div class="wall-head" data-reveal>
        <h2 class="h2">Everything an editor can do, as a tool</h2>
        <p class="lead">
          Each tool explains itself, so an agent that has never seen Graft can use it on the first
          try.
        </p>
      </div>
      <div class="wall-grid" data-reveal>
        {
          tools.map((group) => (
            <div class="wall-col">
              <p class="wall-name">{group.group}</p>
              <ul>
                {group.items.map(([name, does]) => (
                  <li class="tool">
                    <code>{name}</code>
                    <span>{does}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <a class="link" href="/docs/mcp-tools">See every tool in the docs</a>
    </div>
  </section>

  <DayOne />

  <section class="screen" id="connect">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Connected in a minute</h2>
        <ol class="numbered">
          {
            steps.map((step) => (
              <li>
                <h3 class="h3">{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={78} cy={26} seed={61} />
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title"><code>.mcp.json</code></span>
          </div>
          <pre class="code"><code><span class="tk-p">&#123;</span>
  <span class="tk-k">"mcpServers"</span>: <span class="tk-p">&#123;</span>
    <span class="tk-k">"graft"</span>: <span class="tk-p">&#123;</span>
      <span class="tk-k">"command"</span>: <span class="tk-s">"npx"</span>,
      <span class="tk-k">"args"</span>: [<span class="tk-s">"-y"</span>, <span class="tk-s">"@usegraft/cli@latest"</span>, <span class="tk-s">"mcp"</span>]
    <span class="tk-p">&#125;</span>
  <span class="tk-p">&#125;</span>
<span class="tk-p">&#125;</span></code></pre>
          <ul class="win-foot" aria-label="Agents this works with">
            {
              agents.map((agent) => (
                <li title={agent.name}>
                  <Mark name={agent.mark} size={18} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Gate />
</Lab>
