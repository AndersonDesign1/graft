---
/**
 * The Start page, for someone who has never opened a terminal. Its own
 * shape: the hero is the sentence you would say to your agent, in a box you
 * could type it into, and the kinds of site turn over inside it.
 */
import { BookOpen, Images, Newspaper, ShoppingBag, Square } from "lucide-react";
import {
  AstroIcon,
  NextjsIcon,
  NuxtIcon,
  SvelteIcon,
  TanstackIcon,
} from "../components/icons/FrameworkIcons";
import FaqList from "../components/marketing/FaqList.astro";
import Mark from "../components/marketing/Mark.astro";
import NoCode from "../components/marketing/NoCode.astro";
import Shot from "../components/marketing/Shot.astro";
import Marketing from "../layouts/Marketing.astro";

const prompt = "Set up a Graft site for me.";
const wants = ["a shop for my bakery", "a blog I can write on", "a portfolio for my photos", "the docs for my product"];
const kinds = [
  { name: "Blog", line: "For writing regularly", Icon: Newspaper },
  { name: "Docs", line: "For guides and reference", Icon: BookOpen },
  { name: "Shop", line: "For products, or a menu", Icon: ShoppingBag },
  { name: "Portfolio", line: "For showing your work", Icon: Images },
  { name: "Blank", line: "Start empty", Icon: Square },
];
const path = [
  { title: "Say what you want", body: "A shop, a blog, a portfolio, your docs. One sentence is enough." },
  { title: "Answer three questions", body: "What the site is for, who will change it, and whether you have a database. \"I don't know\" is a fine answer." },
  { title: "Your site is made", body: "It arrives with example content, so you can see how everything fits before you write a word." },
  { title: "Keep your free database", body: "Your agent hands you a link. Sign up once, at no cost, and the place your content is stored becomes yours." },
  { title: "Try the editor", body: "Open a page, change a word, press Publish, and reload your site. That is the whole job." },
  { title: "Put it online", body: "Your agent sets it up on a host. You open it first, so you are the owner, and you invite everyone else." },
];
const words = [
  { not: "Repository, commit, push", say: "The site's files, save a version" },
  { not: "Database, Postgres", say: "Where the content is stored" },
  { not: "Environment variable", say: "A setting" },
  { not: "Deploy", say: "Put it online" },
];
const promises = [
  "It asks before it publishes anything for you",
  "It never puts your passwords or settings anywhere public",
  "When something fails, it follows the fix Graft gives it before trying anything else",
  "When it is unsure, it checks where things stand and does the one next thing",
];
const builds = [
  { name: "Next.js", Icon: NextjsIcon },
  { name: "Nuxt", Icon: NuxtIcon },
  { name: "SvelteKit", Icon: SvelteIcon },
  { name: "Astro", Icon: AstroIcon },
  { name: "React Router", mark: "reactrouter" },
  { name: "TanStack Start", Icon: TanstackIcon },
];
const questions = [
  { q: "Do I need to know how to code?", a: "No. Your agent does the setup and explains each step in plain words. After that you work in an editor in your browser." },
  { q: "Which agent do I need?", a: "One that can run commands on your computer, such as Claude Code, Codex, Cursor or OpenCode. Give it the line at the top of this page." },
  { q: "What does it cost?", a: "Graft is free and open source. The database your agent makes is free too. It is deleted after 72 hours unless you keep it, which takes one sign-up and costs nothing." },
  { q: "Is the content mine?", a: "Yes. Once you keep the database, your content is in an account you own, and the site runs on a host you choose. Graft has no server of its own that holds it." },
  { q: "Can a developer take over later?", a: "Yes. Everything your agent made is ordinary code and content that a developer can open, read and change." },
  { q: "Can I add a shop or comments later?", a: "Yes. Ask your agent. Graft adds features such as comments, a product catalog or SEO fields as code in your own site." },
];
const outcomes = [
  { title: "A site that runs", body: "With example content in it, so you can see how it fits together before you write a word." },
  { title: "An editor in your browser", body: "Change a page, press publish, and it is live. No rebuild and no code." },
  { title: "A history of every change", body: "If something goes wrong, open the page's history and bring the old version back." },
];
---

<Marketing
  title="Start with Graft"
  description="Get a website you can edit yourself, with an AI agent doing the setup."
  variant="page"
>
  <section class="screen hero start-hero" data-enter>
    <div class="wrap center-copy">
      <h1 class="h1 w-h1">Get a site you can edit, without writing code</h1>
      <p class="lead">
        You do not need to know what a repo or a database is. Tell your agent what you want. It
        sets Graft up and explains each step as it goes.
      </p>
      <div class="composer" aria-label="An example of what to tell your agent">
        <p class="composer-line">
          <span>Make me</span>
          <span class="composer-wants" style={`--count:${wants.length}`}>
            {
              wants.map((want, i) => (
                <span style={`--i:${i}`} aria-hidden={i === 0 ? undefined : "true"}>
                  {want}
                </span>
              ))
            }
          </span>
        </p>
        <div class="composer-foot">
          <span>Then give your agent this</span>
          <button class="btn btn-command" type="button" data-copy={prompt}>
            <span class="btn-command-text">{prompt}</span>
            <svg class="icon icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg class="icon icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span class="visually-hidden" aria-live="polite"></span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <NoCode />

  <section class="screen" id="path">
    <div class="wrap path-wrap">
      <div class="stack-head" data-reveal>
        <h2 class="h2">From one sentence to a site online</h2>
        <p class="lead">Six steps. Your agent does the work in each one and tells you what happened.</p>
      </div>
      <ol class="path" data-reveal>
        {
          path.map((step) => (
            <li>
              <h3 class="h3">{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="screen" id="kinds">
    <div class="wrap kinds">
      <div class="stack-head" data-reveal>
        <h2 class="h2">Start from the kind of site you want</h2>
        <p class="lead">Your agent picks the one that fits your answer. You can change it later.</p>
      </div>
      <ul class="kind-row" data-reveal>
        {
          kinds.map((kind) => (
            <li class="kind">
              <kind.Icon size={28} strokeWidth={1.5} />
              <span class="kind-name">{kind.name}</span>
              <span class="kind-line">{kind.line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="screen screen-short" id="builds">
    <div class="wrap stack">
      <div class="stack-head" data-reveal>
        <h2 class="h2">Built on tools developers already trust</h2>
        <p class="lead">You never have to choose one. If a developer joins later, they will know their way around.</p>
      </div>
      <div class="belt" data-dir="forth" role="group" aria-label="What your site can be built with">
        {
          [0, 1, 2].map((copy) => (
            <ul class="belt-track" aria-hidden={copy > 0 ? "true" : undefined}>
              {builds.map((item) => (
                <li class="chip">
                  {"Icon" in item && item.Icon ? <item.Icon size={22} /> : <Mark name={item.mark ?? ""} size={22} />}
                  {item.name}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen" id="outcome">
    <div class="wrap split split-wide">
      <div class="split-text" data-reveal>
        <h2 class="h2">What you end up with</h2>
        <ol class="numbered">
          {
            outcomes.map((item) => (
              <li>
                <h3 class="h3">{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="tray split-visual" data-peel>
        <Shot name="write" alt="The Studio editor with a page open, its fields above and its content below." />
      </div>
    </div>
  </section>

  <section class="screen" id="plain">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">It talks to you in plain words</h2>
        <p class="lead">
          Your agent is told to leave the jargon out. When it has to use a technical word, it
          explains it once, in a few words.
        </p>
        <ul class="points">
          {promises.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <ul class="split-visual words" data-reveal aria-label="What your agent says in place of technical words">
        {
          words.map((row) => (
            <li>
              <s>{row.not}</s>
              <span>{row.say}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="screen screen-short" id="cost">
    <div class="wrap run">
      <h2 class="h2" data-reveal><span>What it costs</span></h2>
      <div class="closing-cards">
        <div class="closing-card">
          <p class="who">Graft</p>
          <h3 class="h3">Free, and open source</h3>
          <p>There is no plan to pick and no account to make. The code is public under the MIT license.</p>
        </div>
        <div class="closing-card">
          <p class="who">Your database</p>
          <h3 class="h3">Free to start, yours to keep</h3>
          <p>
            Your agent makes one with no account. It holds up to 100 MB and is deleted after 72
            hours unless you keep it, which takes one free sign-up.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FaqList heading="Questions before you start" group="start-faq" items={questions} />
</Marketing>
