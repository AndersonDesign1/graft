---
/**
 * Security, in the new design. Every section of the old page is here: the
 * four defaults, the gate step by step, the two credentials and what each
 * can do, the audit row, an agent edit as a diff, the mechanisms with their
 * docs, and the questions read from the `security` document.
 */
import FaqList from "../components/marketing/FaqList.astro";
import Rings from "../components/marketing/Rings.astro";
import Shot from "../components/marketing/Shot.astro";
import Marketing from "../layouts/Marketing.astro";
import { getGraft } from "../lib/graft";

const doc = await getGraft().getContent("pages", "security");
const faqs = (doc?.data.faqs ?? []).map((faq) => ({ q: faq.question, a: faq.answer }));

const pillars = [
  { title: "Git is the record", body: "Every content change lands as a file in your repository. A change is something you can read and undo before it is anything else." },
  { title: "Destructive waits for you", body: "Anything marked destructive never runs on the first call. It files a request for that one action and stops until a person decides." },
  { title: "Identity is verified, never assumed", body: "Sign-in tokens are checked against the providers you name. A bad token is refused outright, never quietly treated as a guest." },
  { title: "Your infrastructure, nothing phoning home", body: "Your database and your file storage. No telemetry, and no Graft cloud in the path to trust or secure." },
];
const gate = [
  { who: "Agent", text: 'deleteSubmission { id: "sub_9f2c" }', note: "A destructive call" },
  { who: "Graft", text: "403 · approval filed: ap_01H…", note: "Nothing has run" },
  { who: "You", text: "graft approve ap_01H…", note: "Your decision" },
  { who: "Agent", text: 'retry · approval: "ap_01H…"', note: "Tied to this exact request" },
  { who: "Graft", text: "200 { data: … }", note: "Used once. A replay does nothing" },
];
const gateProps = [
  { k: "Once", v: "An approval is used up by the one call it allows" },
  { k: "Exact", v: "Approving one thing can never run another" },
  { k: "Separate", v: "Whoever asked cannot be the one who approves" },
];
const roles = [
  {
    label: "The site's own login",
    sub: "Runs your app and serves its agents",
    can: ["Serve your functions under your access rules", "File an approval request", "Use an approval a person has granted", "Write its own audit rows"],
    cannot: ["Mark a request approved", "Decide its own request", "Change approvals directly"],
  },
  {
    label: "Your login",
    sub: "Used when you run graft approve",
    can: ["Approve or deny requests", "Build, migrate, branch and merge", "Own the database structure"],
    cannot: [],
  },
];
const auditRow = [
  { k: "Who", v: "agent:mcp · 9f2c…" },
  { k: "What", v: "deleteSubmission" },
  { k: "Version of the site", v: "cb3060b" },
  { k: "Result", v: "403" },
  { k: "Took", v: "1.8 ms" },
  { k: "Trace", v: "x-graft-correlation-id" },
];
const receipts = [
  { href: "/docs/audit-and-approvals", title: "Audit and approvals", note: "The gate, end to end" },
  { href: "/docs/auth", title: "Auth", note: "Checking who is calling" },
  { href: "/docs/functions-and-access", title: "Functions and access", note: "Who may call what" },
  { href: "/docs/the-model", title: "How Graft works", note: "Git is the source, the index is derived" },
  { href: "/docs/hardening", title: "Hardening", note: "A site login that cannot approve" },
  { href: "/docs/agent-surface", title: "Agents", note: "Exactly what an agent can reach" },
];
---

<Marketing
  title="Graft security"
  description={doc?.data.description ?? "How Graft keeps an agent-operated site safe."}
  variant="page"
>
  <section class="screen hero" data-enter>
    <div class="wrap page-top">
      <div class="w-hero-copy">
        <h1 class="h1 w-h1">Let the agent drive. Keep the keys.</h1>
        <p class="lead">
          {doc?.data.tagline ?? "Graft assumes the one doing the work is an agent."}
          So the safety is built into how it works, not left to a promise or a setting you might
          forget.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/docs/audit-and-approvals">See how approvals work</a>
          <a class="btn btn-ghost" href="/start">Get started</a>
        </div>
      </div>
      <ol class="bounds-grid pillars" data-reveal>
        {
          pillars.map((item) => (
            <li>
              <h2 class="h3">{item.title}</h2>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="screen" id="gate">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Destructive actions ask twice</h2>
        <p class="lead">
          The first call never runs. It files a request and stops. Only after a person approves
          does the same call, repeated, go through.
        </p>
        <ul class="facts">
          {
            gateProps.map((item) => (
              <li>
                <span>{item.k}</span>
                <span>{item.v}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={78} cy={72} seed={71} />
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">A delete, step by step</span>
          </div>
          <ol class="sequence">
            {
              gate.map((step) => (
                <li>
                  <span class="sequence-who">{step.who}</span>
                  <code>{step.text}</code>
                  <span class="sequence-note">{step.note}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="screen" id="logins">
    <div class="wrap two-up">
      <div class="stack-head" data-reveal>
        <h2 class="h2">The site cannot approve its own request</h2>
        <p class="lead">
          Graft uses two database logins. The one that runs your site can ask. Only yours can say
          yes. Even direct access with the site's login cannot change that.
        </p>
      </div>
      <div class="closing-cards" data-reveal>
        {
          roles.map((role) => (
            <div class="closing-card operator">
              <p class="who">{role.sub}</p>
              <h3 class="h3">{role.label}</h3>
              <ul class="points">
                {role.can.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {
                role.cannot.length > 0 && (
                  <ul class="points points-no">
                    {role.cannot.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen" id="audit">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Every call leaves a row</h2>
        <p class="lead">
          Each function call is recorded: who made it, what it was, how it went and how long it
          took. What they sent is not recorded, so the log never becomes a second copy of your
          users' data.
        </p>
        <a class="link" href="/docs/observability">Read about tracing a call</a>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={24} cy={30} seed={83} />
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">audit_log</span>
          </div>
          <ul class="facts audit-facts">
            {
              auditRow.map((item) => (
                <li>
                  <span>{item.k}</span>
                  <span>
                    <code>{item.v}</code>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="screen" id="diff">
    <div class="wrap split split-wide">
      <div class="split-text" data-reveal>
        <h2 class="h2">An agent's edit is something you can read</h2>
        <p class="lead">
          Agents write files, not hidden records. Every edit shows up as lines removed and lines
          added, in Studio and in Git, before it goes live.
        </p>
        <a class="link" href="/docs/the-model">Read how Graft works</a>
      </div>
      <div class="tray split-visual" data-peel>
        <Shot name="changes" alt="Studio showing the lines removed and added in a page." />
      </div>
    </div>
  </section>

  <section class="screen" id="receipts">
    <div class="wrap wall">
      <div class="wall-head" data-reveal>
        <h2 class="h2">Mechanisms, documented</h2>
        <p class="lead">Each protection links to the page that explains how it is built.</p>
      </div>
      <ul class="receipts" data-reveal>
        {
          receipts.map((item) => (
            <li>
              <a class="receipt" href={item.href}>
                <span class="receipt-title">{item.title}</span>
                <span class="receipt-note">{item.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {faqs.length > 0 && <FaqList heading="Asked about trust" group="security-faq" items={faqs} />}
</Marketing>
