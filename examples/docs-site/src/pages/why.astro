---
/**
 * Why Graft — product story as a full landing composition (not a blog post).
 * Pillars and beats live here; FAQ + meta come from the `why` document.
 */
import { LandingFaq } from "../components/landing/faq";
import Landing from "../layouts/Landing.astro";
import { getGraft } from "../lib/graft";

const doc = await getGraft().getContent("pages", "why");
if (!doc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const faqs = doc.data.faqs ?? [];

const pillars = [
  {
    n: "01",
    title: "Open source",
    body: "Packages live in the monorepo. Read the compiler, the MCP server, the CLI. No hosted CMS black box.",
  },
  {
    n: "02",
    title: "Self-hostable",
    body: "Your Postgres. Your object store. One Docker image, split compose, or handlers mounted in your app.",
  },
  {
    n: "03",
    title: "No dashboard required",
    body: "Admin UIs lock agents behind a mouse. Author MDX, run the CLI, or speak MCP. Same loop for you and the agent.",
  },
  {
    n: "04",
    title: "You still own the gate",
    body: "Destructive ops file an approval. You decide with graft approve. Runtime credentials cannot self-approve.",
  },
] as const;

const beats = [
  {
    n: "01",
    kicker: "how building works",
    head: "Agents already do most of the typing.",
    lede: "Teams ship with agents more than they write every line by hand. A CMS that only works as a human-only admin leaves that work stuck: the agent cannot see the schema or finish the job without someone clicking panels.",
  },
  {
    n: "02",
    kicker: "the lock-out",
    head: "Dashboards were built for mice.",
    lede: "Opaque admin flows make agents second-class. Bolting MCP onto a dashboard rarely matches what a human can do in the panel. Graft refuses that shape: content is MDX in git, schema is TypeScript, ops are CLI and MCP.",
  },
  {
    n: "03",
    kicker: "the loop",
    head: "Let them code. Still get content.",
    lede: "Author MDX or call write_content. graft compile validates and updates the index. Typed reads render in whichever framework you brought. If git and Postgres disagree, recompile. Git wins.",
  },
] as const;

const roles = [
  {
    label: "You",
    items: [
      "Own the repo and merges",
      "Define schema and access in code",
      "Run graft approve on destructive ops",
      "Deploy a hardened runtime role",
    ],
  },
  {
    label: "Your agent",
    items: [
      "Author and refactor content via MCP / CLI",
      "Discover schema with describe_schema",
      "Retry gated calls with the approval id",
      "Call functions under runtime limits",
    ],
  },
] as const;

const receipts = [
  { href: "/docs/what-is-graft", title: "What is Graft", note: "Open source, self-host, the loop" },
  { href: "/docs/branching-previews", title: "Branching", note: "Overlay or Neon CoW previews" },
  { href: "/docs/owned-primitives", title: "Owned primitives", note: "graft add copies source in" },
  { href: "/docs/deploy", title: "Deploy", note: "Container or embedded handlers" },
  { href: "/docs/audit-and-approvals", title: "Approvals", note: "Human gates, audit trail" },
  { href: "/docs/agent-surface", title: "Agent surface", note: "MCP tools that teach the fix" },
] as const;
---

<Landing title={`${doc.data.title} — Graft`} description={doc.data.description}>
  <div class="why landing">
    <section class="why-hero section">
      <p class="section-label"><em>why</em></p>
      <h1>
        Content as code.<br />
        <span class="marked">Skip the dashboard.</span>
      </h1>
      <p class="section-lede why-lede">
        {doc.data.tagline ??
          "Built for agents and the people who run them. Open source. Self-hostable."}
      </p>
      <div class="why-hero-actions">
        <a class="button-primary" href="/docs/what-is-graft">What is Graft</a>
        <a class="button-ghost" href="/docs/getting-started">Getting started</a>
      </div>
    </section>

    <section class="why-pillars section" aria-label="What Graft is">
      <p class="section-label">§00 <em>foundations</em></p>
      <h2>Open source. Self-hostable. <span class="marked">Yours to run.</span></h2>
      <p class="section-lede">
        No Graft cloud in the critical path. Point <code>DATABASE_URL</code> at your database,
        mount your project, ship.
      </p>
      <ul class="why-pillar-grid">
        {
          pillars.map((p) => (
            <li class="why-pillar">
              <span class="why-pillar-n">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      beats.map((b) => (
        <section class="why-beat section">
          <p class="section-label">
            §{b.n} <em>{b.kicker}</em>
          </p>
          <h2>{b.head}</h2>
          <p class="section-lede">{b.lede}</p>
        </section>
      ))
    }

    <section class="why-roles section" aria-label="You and your agent">
      <p class="section-label">§04 <em>roles</em></p>
      <h2>Same product. <span class="marked">Two operators.</span></h2>
      <div class="why-role-grid">
        {
          roles.map((r) => (
            <div class="why-role">
              <p class="why-role-label">{r.label}</p>
              <ul>
                {r.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="why-receipts section" aria-label="Receipts in the docs">
      <p class="section-label">§05 <em>receipts</em></p>
      <h2>Claims with docs attached.</h2>
      <p class="section-lede">Every capability links to the page that teaches it.</p>
      <ul class="why-receipt-grid">
        {
          receipts.map((r) => (
            <li>
              <a href={r.href}>
                <span class="why-receipt-title">{r.title}</span>
                <span class="why-receipt-note">{r.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      faqs.length > 0 && (
        <section class="section" id="faq" aria-labelledby="why-faq-heading">
          <p class="section-label">§06 <em>faq</em></p>
          <h2 id="why-faq-heading">Common questions</h2>
          <LandingFaq items={faqs} />
        </section>
      )
    }

    <section class="section section-start" id="start">
      <p class="section-label"><em>begin</em></p>
      <h2>Drop Graft onto <span class="marked">your repo.</span></h2>
      <p class="section-lede">
        Scaffold locally. Connect your database. Point your agent at MCP or the CLI.
      </p>
      <div class="why-hero-actions">
        <a class="button-primary" href="/docs/getting-started">Getting started</a>
        <a class="button-ghost" href="/docs/deploy">Self-host & deploy</a>
      </div>
    </section>
  </div>
</Landing>
