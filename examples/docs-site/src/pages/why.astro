---
/**
 * Why Graft, in the new design. Every section of the old page is here: the
 * four foundations, the two operators, the claims with their docs, and the
 * questions read from the `why` document. It adds the day-one argument the
 * landing page only states.
 */
import DayOne from "../components/marketing/DayOne.astro";
import FaqList from "../components/marketing/FaqList.astro";
import Marketing from "../layouts/Marketing.astro";
import { getGraft } from "../lib/graft";

const doc = await getGraft().getContent("pages", "why");
const faqs = (doc?.data.faqs ?? []).map((faq) => ({ q: faq.question, a: faq.answer }));

const pillars = [
  { title: "Open source", body: "All of Graft is public. Read how it checks your content, how agents connect, and what the editor does. There is no hosted black box." },
  { title: "Yours to host", body: "Your database, your file storage, your server. Run it as one container, or inside the app you already have." },
  { title: "No dashboard required", body: "An admin screen locks an agent behind a mouse. In Graft you can edit files, use the command line or connect an agent. The editor is there for the people who want one." },
  { title: "You still hold the gate", body: "Anything destructive files a request and waits. A person decides, and the system that runs your site cannot approve its own request." },
];
const roles = [
  {
    label: "You",
    items: ["Own the site's files and what gets merged", "Define the content model and who has access", "Approve or refuse anything destructive", "Choose where it runs"],
  },
  {
    label: "Your agent",
    items: ["Writes and reworks content", "Reads your content model before it writes", "Repeats a held request once you approve it", "Runs your functions within your limits"],
  },
];
const receipts = [
  { href: "/docs/what-is-graft", title: "What is Graft", note: "Open source, self-hosted, how it works" },
  { href: "/docs/branching-previews", title: "Branching", note: "Preview a change before it is live" },
  { href: "/docs/owned-primitives", title: "Owned primitives", note: "Features added as your own code" },
  { href: "/docs/deploy", title: "Deploy", note: "A container, or inside your app" },
  { href: "/docs/audit-and-approvals", title: "Approvals", note: "A person decides, and it is recorded" },
  { href: "/docs/agent-surface", title: "Agents", note: "Tools that tell an agent the fix" },
];
---

<Marketing
  title="Why Graft"
  description={doc?.data.description ?? "Why a CMS built for agents and the people who run them."}
  variant="page"
>
  <section class="screen hero" data-enter>
    <div class="wrap page-top">
      <div class="w-hero-copy">
        <h1 class="h1 w-h1">Content as code. Skip the dashboard.</h1>
        <p class="lead">
          {doc?.data.tagline ?? "Built for how people ship now. Agents and the humans who run them."}
          Most of the work on a site is now done with an agent. Graft is the CMS that was designed
          around that.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/start">Get started</a>
          <a class="btn btn-ghost" href="/docs/what-is-graft">Read what Graft is</a>
        </div>
      </div>
      <ol class="bounds-grid pillars" data-reveal>
        {
          pillars.map((item) => (
            <li>
              <h2 class="h3">{item.title}</h2>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <DayOne />

  <section class="screen" id="operators">
    <div class="wrap two-up">
      <div class="stack-head" data-reveal>
        <h2 class="h2">Same product. Two operators.</h2>
        <p class="lead">You decide. Your agent does the repetitive work. Neither one needs the other's tools.</p>
      </div>
      <div class="closing-cards" data-reveal>
        {
          roles.map((role) => (
            <div class="closing-card operator">
              <p class="who">{role.label}</p>
              <ul class="points">
                {role.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen" id="receipts">
    <div class="wrap wall">
      <div class="wall-head" data-reveal>
        <h2 class="h2">Claims with docs attached</h2>
        <p class="lead">Every claim on this site links to the page that shows how it works.</p>
      </div>
      <ul class="receipts" data-reveal>
        {
          receipts.map((item) => (
            <li>
              <a class="receipt" href={item.href}>
                <span class="receipt-title">{item.title}</span>
                <span class="receipt-note">{item.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {faqs.length > 0 && <FaqList heading="Common questions" group="why-faq" items={faqs} />}
</Marketing>
