---
/** Docs index — the reading path, straight from the content index. */
import Docs from "../../layouts/Docs.astro";
import { docsNav } from "../../lib/nav";

const nav = await docsNav();
---

<Docs
  title="Docs — Graft"
  description="Graft documentation: the model, the SDKs, the agent surface."
>
  <div class="docs-index">
    <h1>Documentation</h1>
    <p class="lede">
      Everything is code: schema, content, functions, and the agent surface.
      Start at the top and read down — the sections are ordered as a path.
    </p>
    {
      nav.map(({ section, entries }) => (
        <section>
          <h2 class="label">{section}</h2>
          <ul>
            {entries.map((entry) => (
              <li>
                <a href={`/docs/${entry.slug}`}>{entry.title}</a>
                <p>{entry.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Docs>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
  }

  .lede {
    color: var(--ink-muted);
    font-size: var(--text-md);
    max-width: 52ch;
    margin-block: var(--space-3) var(--space-8);
  }

  section {
    margin-block-start: var(--space-8);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }

  li + li {
    margin-block-start: var(--space-4);
  }

  li a {
    font-size: var(--text-md);
    font-weight: 500;
  }

  li p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-1);
    max-width: 60ch;
  }
</style>
