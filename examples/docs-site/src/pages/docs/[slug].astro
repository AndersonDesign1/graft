---
/**
 * A doc page in the fumadocs shell: typed read from content_index, body
 * rendered to static HTML (shiki + Callout, zero client JS for prose), TOC
 * parsed from the source headings — Fumadocs is the UI, Graft is the source.
 */
import { DocsShell } from "../../components/docs-shell";
import DocsRoot from "../../layouts/DocsRoot.astro";
import { getGraft } from "../../lib/graft";
import { renderMdx } from "../../lib/mdx";
import { docsPageTree } from "../../lib/nav";

const { slug } = Astro.params;
const doc = slug ? await getGraft().getContent("docs", slug) : null;
if (!doc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const [tree, bodyHtml] = await Promise.all([docsPageTree(), renderMdx(doc.body)]);

/** TOC from the raw MDX: ##/### headings outside code fences, slugged like rehype-slug. */
const toc: Array<{ title: string; url: string; depth: number }> = [];
let inFence = false;
for (const line of doc.body.split("\n")) {
  if (/^\s*(```|~~~)/.test(line)) {
    inFence = !inFence;
    continue;
  }
  if (inFence) continue;
  const match = /^(#{2,3})\s+(.+?)\s*$/.exec(line);
  if (!match) continue;
  const title = match[2].replace(/`/g, "");
  const id = title
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, "")
    .trim()
    .replace(/\s+/g, "-");
  toc.push({ title, url: `#${id}`, depth: match[1].length });
}
---

<DocsRoot title={`${doc.data.title} — Graft docs`} description={doc.data.description}>
  <DocsShell
    tree={tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    toc={toc}
    title={doc.data.title}
    description={doc.data.description}
    client:load
  >
    <div class="prose" set:html={bodyHtml} />
  </DocsShell>
</DocsRoot>
