---
/** A doc page: typed read + real-MDX body rendered to static HTML. */
import Base from "../../layouts/Base.astro";
import { getGraft } from "../../lib/graft";
import { renderMdx } from "../../lib/mdx";

const { slug } = Astro.params;
const doc = slug ? await getGraft().getContent("docs", slug) : null;
if (!doc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const bodyHtml = await renderMdx(doc.body);
---

<Base title={`${doc.data.title} — Graft docs`} description={doc.data.description}>
  <article class="doc">
    <p class="label">{doc.data.section}</p>
    <h1>{doc.data.title}</h1>
    <p class="lede">{doc.data.description}</p>
    <div class="prose" set:html={bodyHtml} />
  </article>
</Base>

<style>
  .doc {
    padding: var(--space-16) var(--space-8);
    max-width: 48rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    margin-block: var(--space-2) var(--space-3);
  }

  .lede {
    color: var(--ink-muted);
    font-size: var(--text-md);
    margin-block-end: var(--space-12);
  }
</style>
