---
/**
 * A doc page in the fumadocs shell: typed read from content_index, body
 * rendered to static HTML (shiki + Callout, zero client JS for prose), TOC
 * parsed from the source headings — Fumadocs is the UI, Graft is the source.
 */
import { DocsShell } from "../../components/docs-shell";
import DocsRoot from "../../layouts/DocsRoot.astro";
import { docSourcePath } from "../../lib/doc-source";
import { getGraft } from "../../lib/graft";
import { lastUpdated } from "../../lib/last-updated";
import { renderMdx } from "../../lib/mdx";
import { docsPageTree } from "../../lib/nav";
import { extractHeadings } from "../../lib/search-results";

/**
 * Every doc prerenders: the index is compiled from files in git, so the full
 * set is known before the build runs.
 */
export async function getStaticPaths() {
  const docs = await getGraft().listContent("docs");
  return docs.map((doc) => ({ params: { slug: doc.slug } }));
}

const { slug } = Astro.params;
const doc = slug ? await getGraft().getContent("docs", slug) : null;
if (!doc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const [tree, bodyHtml] = await Promise.all([docsPageTree(), renderMdx(doc.body)]);

/**
 * TOC from the raw MDX, through the same extractor search uses.
 *
 * This was a second, hand-rolled slugger, and it disagreed with rehype-slug in
 * two ways that both produced links to nowhere: it stripped underscores, and
 * it never disambiguated a repeated heading. On the generated error reference
 * that made 41 of 43 entries dead — every error code in the list. There is one
 * slugger now, and anchor-parity.test.ts holds it to the rendered page.
 */
const toc = extractHeadings(doc.body)
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({ title: heading.text, url: `#${heading.id}`, depth: heading.depth }));

/**
 * The page header: the kicker is the page's one-sentence promise, so it sits
 * under the title as the lede instead of as the first line of the body. The
 * Markdown twin keeps it in place (llms.ts reads the source, not this HTML).
 */
const KICKER = /^\s*<p class="kicker">([\s\S]*?)<\/p>/;
const lede = KICKER.exec(bodyHtml)?.[1];
const body = lede === undefined ? bodyHtml : bodyHtml.replace(KICKER, "");

/** Reading time from the prose, at a plain 230 words a minute, code included. */
const minutes = Math.max(1, Math.round(doc.body.split(/\s+/).filter(Boolean).length / 230));

/** When the source last changed in git, or nothing if history is unavailable. */
const updated = lastUpdated(docSourcePath(doc.slug))?.toISOString();
---

<DocsRoot
  title={`${doc.data.title} — Graft docs`}
  description={doc.data.description}
  markdownHref={`/docs/${doc.slug}.md`}
  ogImage={`/og/${doc.slug}.png`}
>
  <DocsShell
    tree={tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    toc={toc}
    title={doc.data.title}
    slug={doc.slug}
    section={doc.data.section}
    lede={lede}
    minutes={minutes}
    updated={updated}
    client:load
  >
    <div class="prose" set:html={body} />
  </DocsShell>
</DocsRoot>
