---
/**
 * The Agents page. Its own shape: the exchange is the hero, and the middle
 * of the page is a wall of every tool an agent gets, in plain words.
 */
import Command from "../components/marketing/Command.astro";
import DayOne from "../components/marketing/DayOne.astro";
import FaqList from "../components/marketing/FaqList.astro";
import Gate from "../components/marketing/Gate.astro";
import Mark from "../components/marketing/Mark.astro";
import Rings from "../components/marketing/Rings.astro";
import Transcript from "../components/marketing/Transcript.astro";
import { agents } from "../components/marketing/agents";
import Marketing from "../layouts/Marketing.astro";

const tools = [
  {
    group: "Read",
    items: [
      ["get_content", "Open one page"],
      ["list_content", "List what a collection holds"],
      ["search_content", "Search all your content"],
      ["list_collections", "See the kinds of content you have"],
      ["list_branches", "See your preview branches"],
    ],
  },
  {
    group: "Write",
    items: [
      ["write_content", "Create or edit a page"],
      ["put_asset", "Upload an image or a file"],
      ["delete_content", "Ask to delete a page"],
      ["run_function", "Run one of your functions"],
    ],
  },
  {
    group: "Understand",
    items: [
      ["describe_schema", "Read your content model"],
      ["describe_function", "See what a function needs"],
      ["explain_error", "Get the fix for an error"],
      ["list_registry", "See features it can add"],
      ["list_compilations", "See what each build changed"],
    ],
  },
  {
    group: "Stay in bounds",
    items: [
      ["list_approvals", "See what is waiting for a person"],
      ["list_functions", "See what it is allowed to run"],
      ["list_packages", "See what is installed"],
    ],
  },
];
const prompts = [
  { name: "author-document", give: "A collection and a topic", get: "The real fields of that collection, with the required ones marked" },
  { name: "revise-document", give: "A page and what you want changed", get: "Where the page lives and what its fields allow" },
  { name: "fix-error", give: "An error code", get: "What it means, why it usually happens, and how to recover" },
  { name: "plan-migration", give: "A collection and the change you want", get: "The current fields and the safe steps, as a commit you review" },
];
const bounds = [
  { title: "Every write is checked", body: "A page that does not fit your content model is refused, with a message saying what to fix." },
  { title: "Content cannot run code", body: "Anything in a page that could run on your server is refused before it is saved." },
  { title: "Your rules still apply", body: "When an agent runs one of your functions, the same access rules, rate limits and audit log apply as for your app's users." },
  { title: "Deletes wait for a person", body: "A delete files a request and stops. Nothing is removed until someone on your team approves it." },
];
const levels = [
  { name: "Read", can: "Reads content" },
  { name: "Write drafts", can: "Writes drafts and opens a pull request" },
  { name: "Publish", can: "Publishes" },
];
const questions = [
  { q: "Which agents work with Graft?", a: "Any agent that speaks MCP: Claude Code, Codex, Cursor, OpenCode, T3 Code, Gemini CLI, Copilot and others. Agents that only run shell commands can use the CLI, which prints JSON." },
  { q: "Does agent access cost extra?", a: "No. Graft is open source under the MIT license. The MCP server is part of it, with every tool included." },
  { q: "Can an agent delete my content?", a: "Not by itself. A delete files an approval request and stops. A person approves or denies it, and an approval works once, for that one page." },
  { q: "Can I see what an agent did?", a: "Yes. Content changes are files in Git, so every edit has a history. Function calls are recorded in the audit log with who called them and how it went." },
  { q: "Do my editors need to use an agent?", a: "No. Studio is a full editor in the browser. Agents and editors work on the same drafts, and neither needs the other." },
];
const steps = [
  { title: "Add Graft to your agent", body: "One entry in your agent's MCP settings. It is the same for every agent." },
  { title: "Ask in plain words", body: "\"Add a pricing page.\" The agent reads your content model and writes the page." },
  { title: "Review what it did", body: "Every change is a file in Git. Read it, undo it, or let it ship." },
];
---

<Marketing
  title="Graft for agents"
  description="What an AI agent can do in a Graft project, how it connects, and the limits that keep your content safe."
  variant="page"
>
  <section class="screen hero" data-enter>
    <div class="wrap split split-hero">
      <div class="split-text">
        <h1 class="h1 w-h1">A CMS your agent can run</h1>
        <p class="lead">
          Connect the agent you already use. It reads your content model, writes and edits your
          pages, and asks a person before it deletes anything.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/docs/connecting-agents">Connect an agent</a>
          <Command command="graft mcp" quiet />
        </div>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={20} cy={78} seed={11} />
        <Transcript />
      </div>
    </div>
  </section>

  <section class="screen screen-short" id="works-with">
    <div class="wrap stack">
      <div class="stack-head" data-reveal>
        <h2 class="h2">Use the agent you already have</h2>
      </div>
      <div class="belt" data-dir="forth" role="group" aria-label="Agents Graft works with">
        {
          [0, 1, 2].map((copy) => (
            <ul class="belt-track" aria-hidden={copy > 0 ? "true" : undefined}>
              {agents.map((agent) => (
                <li class="chip">
                  <Mark name={agent.mark} size={22} />
                  {agent.name}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <section class="screen" id="tools">
    <div class="wrap wall">
      <div class="wall-head" data-reveal>
        <h2 class="h2">Everything an editor can do, as a tool</h2>
        <p class="lead">
          Each tool explains itself, so an agent that has never seen Graft can use it on the first
          try.
        </p>
      </div>
      <div class="wall-grid" data-reveal>
        {
          tools.map((group) => (
            <div class="wall-col">
              <p class="wall-name">{group.group}</p>
              <ul>
                {group.items.map(([name, does]) => (
                  <li class="tool">
                    <code>{name}</code>
                    <span>{does}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <a class="link" href="/docs/mcp-tools">See every tool in the docs</a>
    </div>
  </section>

  <DayOne />

  <section class="screen" id="workflows">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Ready-made jobs, filled in from your project</h2>
        <p class="lead">
          Pick a job and your agent starts with the facts of your own site, not a guess. Each one
          tells it how to work safely here.
        </p>
        <a class="link" href="/docs/mcp-resources-and-prompts">Read about prompts and attachments</a>
      </div>
      <ol class="split-visual ledger" data-reveal>
        {
          prompts.map((prompt) => (
            <li>
              <code class="ledger-name">{prompt.name}</code>
              <p>
                <span>You give it</span>
                {prompt.give}
              </p>
              <p>
                <span>It gets</span>
                {prompt.get}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="screen" id="bounds">
    <div class="wrap bounds">
      <div class="stack-head" data-reveal>
        <h2 class="h2">An agent gets no special access</h2>
        <p class="lead">
          Everything it does goes through the same checks as a person using your site or your
          terminal.
        </p>
      </div>
      <ol class="bounds-grid" data-reveal>
        {
          bounds.map((item) => (
            <li>
              <h3 class="h3">{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="screen" id="connect">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">Connected in a minute</h2>
        <ol class="numbered">
          {
            steps.map((step) => (
              <li>
                <h3 class="h3">{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="tray split-visual" data-peel>
        <Rings cx={78} cy={26} seed={61} />
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title"><code>.mcp.json</code></span>
          </div>
          <pre class="code"><code><span class="tk-p">&#123;</span>
  <span class="tk-k">"mcpServers"</span>: <span class="tk-p">&#123;</span>
    <span class="tk-k">"graft"</span>: <span class="tk-p">&#123;</span>
      <span class="tk-k">"command"</span>: <span class="tk-s">"npx"</span>,
      <span class="tk-k">"args"</span>: [<span class="tk-s">"-y"</span>, <span class="tk-s">"@usegraft/cli@latest"</span>, <span class="tk-s">"mcp"</span>]
    <span class="tk-p">&#125;</span>
  <span class="tk-p">&#125;</span>
<span class="tk-p">&#125;</span></code></pre>
          <ul class="win-foot" aria-label="Agents this works with">
            {
              agents.map((agent) => (
                <li title={agent.name}>
                  <Mark name={agent.mark} size={18} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="screen" id="tokens">
    <div class="wrap split">
      <div class="split-text" data-reveal>
        <h2 class="h2">One key per agent, and you choose what it opens</h2>
        <p class="lead">
          On a hosted site, each agent gets its own key from Studio. Pick how much it may do, and
          take the key back the moment you want to.
        </p>
        <ul class="points">
          <li>Its work arrives as drafts, in the same place your editors review</li>
          <li>Without the publish level, it opens a pull request instead</li>
          <li>Revoke a key and the agent is refused from its next request</li>
        </ul>
        <a class="link" href="/docs/connecting-agents">Read about connecting over HTTP</a>
      </div>
      <div class="split-visual keycard" data-reveal>
        <p class="keycard-key"><code>graft_at_…</code></p>
        <ol class="keycard-levels">
          {
            levels.map((level, i) => (
              <li style={`--step:${i}`}>
                <span class="stair-name">{level.name}</span>
                <span class="stair-can">{level.can}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <Gate />

  <section class="screen screen-short" id="docs-agents">
    <div class="wrap run">
      <div class="closing-cards">
        <div class="closing-card">
          <p class="who">For other people's agents</p>
          <h3 class="h3">Let agents read your docs</h3>
          <p>
            A second, read-only endpoint serves your documentation to anyone's agent. It is
            separate from the private one, and it cannot write.
          </p>
          <a class="link" href="/docs/docs-mcp">Read about the public docs endpoint</a>
        </div>
        <div class="closing-card">
          <p class="who">For scripts and CI</p>
          <h3 class="h3">The same work, from a terminal</h3>
          <p>
            Every command prints JSON and exits with a code that says what kind of failure it was,
            so a script or an agent that runs shell commands can drive Graft too.
          </p>
          <a class="link" href="/docs/cli">Read about scripting the CLI</a>
        </div>
      </div>
    </div>
  </section>

  <FaqList heading="Questions about agents" group="agents-faq" items={questions} />
</Marketing>
