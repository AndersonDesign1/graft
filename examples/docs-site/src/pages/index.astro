---
/**
 * The landing page. A marketing page for two readers, the developer and the
 * person who never opens a terminal: the claim over a wide window of the
 * real Studio, the stack it fits, what agents get and what people get, how
 * the loop works, and everything the old page said, in order.
 */
import Audience from "../components/marketing/Audience.astro";
import Bento from "../components/marketing/Bento.astro";
import Branching from "../components/marketing/Branching.astro";
import Command from "../components/marketing/Command.astro";
import DayOne from "../components/marketing/DayOne.astro";
import Faq from "../components/marketing/Faq.astro";
import Gate from "../components/marketing/Gate.astro";
import HeroWide from "../components/marketing/HeroWide.astro";
import Mark from "../components/marketing/Mark.astro";
import Model from "../components/marketing/Model.astro";
import NoCode from "../components/marketing/NoCode.astro";
import Primitives from "../components/marketing/Primitives.astro";
import Reads from "../components/marketing/Reads.astro";
import Seam from "../components/marketing/Seam.astro";
import Stack from "../components/marketing/Stack.astro";
import Tiers from "../components/marketing/Tiers.astro";
import { agents } from "../components/marketing/agents";
import Marketing from "../layouts/Marketing.astro";
---

<Marketing
  title="Graft, the CMS for agents and the people who run them"
  description="An open-source CMS that keeps your content in your own repo, lets AI agents edit it safely, and gives your team an editor in the browser."
  variant="landing"
>
  <HeroWide />
  <Stack />
  <Audience />
  <DayOne />
  <NoCode />
  <Model id="how" heading="Edit a file. Compile. Refresh." steps plain />
  <Seam mode="section" />
  <Reads frameworks heading="One schema. No codegen." />
  <Gate />
  <Branching />
  <Bento />
  <Tiers />
  <Primitives />
  <Faq />

  <Fragment slot="closing">
    <div class="closing-lead closing-drop">
      <h2 class="h2">Drop Graft onto your repo</h2>
      <p class="lead">Developers set it up in a minute. Agents and editors take it from there.</p>
    </div>
    <div class="closing-cards">
      <div class="closing-card">
        <p class="who">
          <span class="who-marks">
            {agents.slice(0, 5).map((agent) => <Mark name={agent.mark} size={18} />)}
          </span>
          For your agent
        </p>
        <h3 class="h3">Connect it over MCP</h3>
        <p>It works with Claude Code, Codex, Cursor, OpenCode, T3 Code and anything else that speaks MCP.</p>
        <Command command="graft mcp" />
      </div>
      <div class="closing-card">
        <p class="who">For you</p>
        <h3 class="h3">Let your agent set it up</h3>
        <p>Paste one sentence into the agent you use. It asks three questions, then sets up your site.</p>
        <button class="btn btn-primary" type="button" data-agent-open>Set up with your agent</button>
      </div>
    </div>
  </Fragment>
</Marketing>
