---
/**
 * The landing — five sections on one persistent stage.
 *
 * v5 (docs/design-notes/landing-redesign.md §3): the page scrolls like a
 * document, but the background never changes and the product frame holds.
 * Hero → the stage (four beats against one sticky frame) → branching →
 * FAQ → CTA. Everything is still live: the terminal types real CLI output,
 * the MCP transcript replays a real error → fix exchange, the branching model
 * is a toy you can poke, and the contact form writes an actual data_records
 * row. Hero copy + FAQ come from the `home` document — the page eats its own
 * dogfood.
 */
import { BranchingDemo } from "../components/landing/branching";
import { ClosingCta } from "../components/landing/cta";
import { LandingFaq } from "../components/landing/faq";
import { Hero } from "../components/landing/hero";
import { Stage } from "../components/landing/stage";
import Landing from "../layouts/Landing.astro";
import { getGraft } from "../lib/graft";
import {
  HERO_INIT,
  STAGE_COMPILE,
  STAGE_SELFHOST,
  highlightSession,
} from "../lib/highlight";

const doc = await getGraft().getContent("pages", "home");
const faqs = doc?.data.faqs ?? [];

// Tokenized at build time with the same shiki themes the docs use, so the
// terminals and a fenced ```console block are colored by one highlighter.
const [heroTerminal, compileTerminal, selfhostTerminal] = await Promise.all([
  highlightSession(HERO_INIT),
  highlightSession(STAGE_COMPILE),
  highlightSession(STAGE_SELFHOST),
]);
---

<Landing
  title="Graft — CMS for agents and the people who run them"
  description={doc?.data.description ??
    "Content as code: MDX in git, one Zod schema, a derived Postgres index. CLI and MCP — no dashboard required."}
>
  <div class="landing">
    <Hero tagline={doc?.data.tagline} terminal={heroTerminal} client:load />

    <Stage compile={compileTerminal} selfhost={selfhostTerminal} client:visible />

    <section class="section" id="branching">
      <p class="section-label">§05 <em>branching</em></p>
      <div class="reveal">
        <h2>Branch content the way you branch code.</h2>
        <p class="section-lede">
          Copy-on-write overlays on any Postgres, or Neon forks when you want a physical
          database. Merge dry-runs first. Pick a step:
        </p>
      </div>
      <BranchingDemo client:visible />
    </section>

    <section class="section" id="faq">
      <p class="section-label">§06 <em>faq — served from content_index</em></p>
      <div class="reveal">
        <h2>Common questions</h2>
      </div>
      <LandingFaq items={faqs.slice(0, 5)} />
    </section>

    <section class="section section-start" id="start">
      <p class="section-label"><em>begin</em></p>
      <div class="reveal">
        <h2>Drop Graft onto <span class="marked">your repo.</span></h2>
        <p class="section-lede cta-subhead">You scaffold. Your agent authors.</p>
        <p class="section-lede">
          Open source and self-hostable. One command writes <code>graft.config.ts</code> and
          the first MDX doc. You and a cold agent share the same loop: compile, branch, merge.
          No admin login.
        </p>
      </div>
      <ClosingCta client:visible />
    </section>
  </div>
</Landing>
