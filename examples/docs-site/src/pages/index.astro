---
/**
 * Landing placeholder — the real landing (bento + live studio elements +
 * animated SVGs) is execution step 4 in the P7.5 design note. This page
 * already dogfoods the loop: everything below is a Graft read.
 */
import Base from "../layouts/Base.astro";
import { getGraft } from "../lib/graft";
import { renderMdx } from "../lib/mdx";

const home = await getGraft().getContent("pages", "home");
const bodyHtml = home ? await renderMdx(home.body) : "";
---

<Base
  title={home ? `${home.data.title} — the agent-native CMS` : "Graft"}
  description={home?.data.description}
>
  <section class="hero">
    <p class="label">/* read from content_index via @graft/sdk-astro */</p>
    <h1>{home?.data.title ?? "Graft"}</h1>
    {home?.data.tagline && <p class="tagline">{home.data.tagline}</p>}
    <div class="prose" set:html={bodyHtml} />
    <a class="cta pressable" href="/docs/getting-started">Get started</a>
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-24) var(--space-8);
    max-width: 56rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-4) var(--space-6);
  }

  .tagline {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: 34ch;
    margin-block-end: var(--space-8);
  }

  .cta {
    display: inline-block;
    margin-block-start: var(--space-8);
    background: var(--wax);
    color: var(--paper);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-inner);
    transition:
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      background: var(--wax-deep);
    }
  }
</style>
