---
/**
 * Everything in the box: the parts of a CMS you would otherwise bolt on,
 * each with a picture of it at work. The editor is a real screenshot. The
 * rest are drawn for this page in the ink color and move only to show what
 * the feature does.
 *
 * The preview drawing tells its whole story: a branch leaves the live line,
 * a page on it gets a new headline, reviewers see it, and when the branch
 * rejoins, the live page takes the change.
 */
import { Blocks, FileClock, GitBranch, Image, PenLine, Search, Users } from "lucide-react";
import Shot from "./Shot.astro";

const roles = [
  { name: "Viewer", can: "Reads", level: 1 },
  { name: "Contributor", can: "Drafts", level: 2 },
  { name: "Editor", can: "Publishes", level: 3 },
  { name: "Admin", can: "Approves", level: 4 },
];
---

<section class="screen" id="everything">
  <div class="wrap bento-wrap">
    <div class="bento-head" data-reveal>
      <h2 class="h2">Everything a CMS needs, in the box</h2>
      <p class="lead">
        Search, previews, roles, images and a full history come with Graft. There is nothing to
        buy, connect or maintain on the side.
      </p>
    </div>
    <div class="bento" data-reveal>
      <article class="cell cell-studio">
        <div class="cell-text">
          <h3 class="cell-title"><PenLine size={18} strokeWidth={1.75} />An editor your team can use today</h3>
          <p>Lists, a rich text editor, drafts and publish. It ships with Graft.</p>
        </div>
        <div class="cell-art cell-shot" aria-hidden="true">
          <Shot name="write" alt="" />
        </div>
      </article>

      <article class="cell cell-search">
        <div class="cell-text">
          <h3 class="cell-title"><Search size={18} strokeWidth={1.75} />Search, with no search service</h3>
          <p>Ranked results and highlighted snippets across all your content.</p>
        </div>
        <svg class="cell-art art-search" viewBox="0 0 560 118" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <rect class="art-line" x="1" y="1" width="558" height="34" rx="6"></rect>
          <circle class="art-line" cx="19" cy="17" r="5.5"></circle>
          <path class="art-line" d="m23.5 21.5 4.5 4.5"></path>
          <text class="art-type" x="38" y="22">pricing plans</text>
          <g class="art-result" style="--n:0">
            <rect class="art-fill" x="1" y="46" width="558" height="20" rx="4"></rect>
            <rect class="art-hit" x="12" y="53" width="60" height="6" rx="2"></rect>
            <rect class="art-dim" x="80" y="53" width="150" height="6" rx="2"></rect>
          </g>
          <g class="art-result" style="--n:1">
            <rect class="art-fill" x="1" y="71" width="558" height="20" rx="4"></rect>
            <rect class="art-dim" x="12" y="78" width="90" height="6" rx="2"></rect>
            <rect class="art-hit" x="110" y="78" width="44" height="6" rx="2"></rect>
            <rect class="art-dim" x="162" y="78" width="80" height="6" rx="2"></rect>
          </g>
          <g class="art-result" style="--n:2">
            <rect class="art-fill" x="1" y="96" width="558" height="20" rx="4"></rect>
            <rect class="art-dim" x="12" y="103" width="130" height="6" rx="2"></rect>
            <rect class="art-hit" x="150" y="103" width="36" height="6" rx="2"></rect>
          </g>
        </svg>
      </article>

      <article class="cell cell-preview">
        <div class="cell-text">
          <h3 class="cell-title"><GitBranch size={18} strokeWidth={1.75} />Preview before it goes live</h3>
          <p>Change a page on a branch, share it, then merge. Your live site waits.</p>
        </div>
        <svg class="cell-art art-preview" viewBox="0 0 560 118" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <!-- the live line, and the branch that leaves and rejoins it -->
          <path class="art-line" d="M6 92 H554"></path>
          <path class="art-line art-draw" pathLength="1" d="M110 92 C152 92 152 34 198 34 H342 C388 34 388 92 430 92"></path>
          <circle class="art-node" cx="110" cy="92" r="3.5"></circle>
          <circle class="art-node art-merge" cx="430" cy="92" r="3.5"></circle>
          <text class="art-label" x="6" y="110">Live</text>
          <text class="art-label art-branch-label" x="198" y="24">Preview</text>

          <!-- the page on the branch: its headline changes -->
          <g transform="translate(243 44)">
            <g class="art-page art-page-preview">
            <rect class="art-card" width="54" height="40" rx="4"></rect>
            <rect class="art-dim art-old" x="7" y="8" width="26" height="5" rx="1.5"></rect>
            <rect class="art-hit art-new" x="7" y="8" width="38" height="5" rx="1.5"></rect>
            <rect class="art-dim" x="7" y="19" width="40" height="3" rx="1.5"></rect>
            <rect class="art-dim" x="7" y="26" width="32" height="3" rx="1.5"></rect>
          </g>
          </g>

          <!-- the live page: it takes the change only after the merge -->
          <g class="art-page" transform="translate(486 46)">
            <rect class="art-card" width="54" height="40" rx="4"></rect>
            <rect class="art-dim art-live-old" x="7" y="8" width="26" height="5" rx="1.5"></rect>
            <rect class="art-hit art-live-new" x="7" y="8" width="38" height="5" rx="1.5"></rect>
            <rect class="art-dim" x="7" y="19" width="40" height="3" rx="1.5"></rect>
            <rect class="art-dim" x="7" y="26" width="32" height="3" rx="1.5"></rect>
          </g>
          <circle class="art-dot" r="4"></circle>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><Users size={18} strokeWidth={1.75} />Roles for your team</h3>
          <p>Sign-in and four roles, built in.</p>
        </div>
        <ul class="cell-art art-roles" aria-label="Roles and what each can do">
          {
            roles.map((role) => (
              <li>
                <span class="role-name">{role.name}</span>
                <span class="role-meter" aria-hidden="true">
                  {[1, 2, 3, 4].map((step) => (
                    <i data-on={step <= role.level ? "" : undefined} />
                  ))}
                </span>
                <span class="role-can">{role.can}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><FileClock size={18} strokeWidth={1.75} />A record of every change</h3>
          <p>Who did what and when, for people and agents.</p>
        </div>
        <svg class="cell-art art-log" viewBox="0 0 220 76" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <g class="art-rows">
            <g><circle class="art-node" cx="6" cy="-14" r="3"></circle><rect class="art-hit" x="18" y="-17" width="64" height="6" rx="2"></rect><rect class="art-dim" x="90" y="-17" width="70" height="6" rx="2"></rect></g>
            <g><circle class="art-ring" cx="6" cy="8" r="3"></circle><rect class="art-dim" x="18" y="5" width="96" height="6" rx="2"></rect><rect class="art-dim" x="122" y="5" width="44" height="6" rx="2"></rect></g>
            <g><circle class="art-ring" cx="6" cy="30" r="3"></circle><rect class="art-dim" x="18" y="27" width="60" height="6" rx="2"></rect><rect class="art-dim" x="86" y="27" width="86" height="6" rx="2"></rect></g>
            <g><circle class="art-ring" cx="6" cy="52" r="3"></circle><rect class="art-dim" x="18" y="49" width="84" height="6" rx="2"></rect><rect class="art-dim" x="110" y="49" width="50" height="6" rx="2"></rect></g>
            <g><circle class="art-ring" cx="6" cy="74" r="3"></circle><rect class="art-dim" x="18" y="71" width="70" height="6" rx="2"></rect><rect class="art-dim" x="96" y="71" width="60" height="6" rx="2"></rect></g>
          </g>
          <path class="art-line" d="M6 0 V76"></path>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><Image size={18} strokeWidth={1.75} />Images and files</h3>
          <p>Stored in your own bucket, linked from content.</p>
        </div>
        <svg class="cell-art art-media" viewBox="0 0 220 76" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <rect class="art-fill" x="1" y="1" width="104" height="74" rx="6"></rect>
          <path class="art-line" d="m12 62 24-26 18 18 12-12 28 20"></path>
          <circle class="art-line" cx="80" cy="22" r="7"></circle>
          <rect class="art-fill art-tile" style="--n:0" x="114" y="1" width="50" height="34" rx="6"></rect>
          <rect class="art-fill art-tile" style="--n:1" x="169" y="1" width="50" height="34" rx="6"></rect>
          <rect class="art-fill art-tile" style="--n:2" x="114" y="41" width="105" height="34" rx="6"></rect>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><Blocks size={18} strokeWidth={1.75} />Forms, orders and comments</h3>
          <p>Add Postgres and Graft stores what visitors send.</p>
        </div>
        <svg class="cell-art art-form" viewBox="0 0 220 76" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <rect class="art-line" x="1" y="1" width="92" height="18" rx="4"></rect>
          <rect class="art-line" x="1" y="25" width="92" height="18" rx="4"></rect>
          <rect class="art-hit" x="1" y="51" width="46" height="18" rx="4"></rect>
          <path class="art-line art-send" pathLength="1" d="M100 60 H126 C140 60 140 22 154 22"></path>
          <rect class="art-fill" x="156" y="6" width="63" height="14" rx="3"></rect>
          <rect class="art-fill art-saved" x="156" y="24" width="63" height="14" rx="3"></rect>
          <rect class="art-fill" x="156" y="42" width="63" height="14" rx="3"></rect>
          <rect class="art-fill" x="156" y="60" width="63" height="14" rx="3"></rect>
        </svg>
      </article>
    </div>
  </div>
</section>
