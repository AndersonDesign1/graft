---
/**
 * Everything in the box: the parts of a CMS you would otherwise bolt on,
 * each with a small picture of it at work. The pictures are drawn for this
 * page in the ink color and move only where the movement says what the
 * feature does: a query finding its results, a branch leaving and rejoining,
 * a change landing in the log.
 */
import { Blocks, FileClock, GitBranch, Image, PenLine, Search, ShieldCheck, Users } from "lucide-react";
---

<section class="screen" id="everything">
  <div class="wrap bento-wrap">
    <div class="bento-head" data-reveal>
      <h2 class="h2">Everything a CMS needs, in the box</h2>
      <p class="lead">
        Search, previews, roles, images and a full history come with Graft. There is nothing to
        buy, connect or maintain on the side.
      </p>
    </div>
    <div class="bento" data-reveal>
      <article class="cell cell-wide cell-studio">
        <div class="cell-text">
          <h3 class="cell-title"><PenLine size={18} strokeWidth={1.75} />An editor your team can use today</h3>
          <p>Lists, a rich text editor, drafts and publish. It ships with Graft.</p>
        </div>
        <div class="cell-art cell-shot" aria-hidden="true">
          <div class="window">
            <div class="window-bar">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span class="window-title">graft studio</span>
            </div>
            <img class="studio-poster-dark" src="/lab/studio-dark.jpg" alt="" width="2560" height="1600" loading="lazy" />
            <img class="studio-poster-light" src="/lab/studio-light.jpg" alt="" width="2560" height="1600" loading="lazy" />
          </div>
        </div>
      </article>

      <article class="cell cell-wide">
        <div class="cell-text">
          <h3 class="cell-title"><Search size={18} strokeWidth={1.75} />Search, with no search service</h3>
          <p>Ranked results and highlighted snippets across all your content.</p>
        </div>
        <svg class="cell-art art-search" viewBox="0 0 360 150" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <rect class="art-line" x="1" y="1" width="358" height="38" rx="6"></rect>
          <circle class="art-line" cx="20" cy="19" r="6"></circle>
          <path class="art-line" d="m25 24 5 5"></path>
          <text class="art-type" x="40" y="24">pricing plans</text>
          <rect class="art-caret" x="40" y="10" width="1.5" height="18"></rect>
          <g class="art-result" style="--n:0">
            <rect class="art-fill" x="1" y="54" width="358" height="26" rx="5"></rect>
            <rect class="art-hit" x="14" y="63" width="64" height="8" rx="2"></rect>
            <rect class="art-dim" x="86" y="63" width="150" height="8" rx="2"></rect>
          </g>
          <g class="art-result" style="--n:1">
            <rect class="art-fill" x="1" y="86" width="358" height="26" rx="5"></rect>
            <rect class="art-dim" x="14" y="95" width="90" height="8" rx="2"></rect>
            <rect class="art-hit" x="112" y="95" width="46" height="8" rx="2"></rect>
            <rect class="art-dim" x="166" y="95" width="80" height="8" rx="2"></rect>
          </g>
          <g class="art-result" style="--n:2">
            <rect class="art-fill" x="1" y="118" width="358" height="26" rx="5"></rect>
            <rect class="art-dim" x="14" y="127" width="130" height="8" rx="2"></rect>
            <rect class="art-hit" x="152" y="127" width="38" height="8" rx="2"></rect>
          </g>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><GitBranch size={18} strokeWidth={1.75} />Preview branches</h3>
          <p>Try a change away from your live site, then merge.</p>
        </div>
        <svg class="cell-art art-branch" viewBox="0 0 220 90" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <path class="art-line" d="M8 62 H212"></path>
          <path class="art-line art-draw" pathLength="1" d="M48 62 C78 62 78 24 108 24 H132 C162 24 162 62 192 62"></path>
          <circle class="art-node" cx="48" cy="62" r="4"></circle>
          <circle class="art-node" cx="192" cy="62" r="4"></circle>
          <circle class="art-dot" r="4"></circle>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><Users size={18} strokeWidth={1.75} />Roles for your team</h3>
          <p>Sign-in and four roles, with no extra service.</p>
        </div>
        <ul class="cell-art art-roles" aria-label="Roles">
          <li>Viewer</li>
          <li>Contributor</li>
          <li>Editor</li>
          <li>Admin</li>
        </ul>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><FileClock size={18} strokeWidth={1.75} />A record of every change</h3>
          <p>Who did what and when, for people and agents.</p>
        </div>
        <svg class="cell-art art-log" viewBox="0 0 220 90" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <g class="art-rows">
            <g class="art-row"><circle class="art-node" cx="8" cy="12" r="3"></circle><rect class="art-hit" x="20" y="8" width="70" height="8" rx="2"></rect><rect class="art-dim" x="98" y="8" width="60" height="8" rx="2"></rect></g>
            <g class="art-row"><circle class="art-node" cx="8" cy="36" r="3"></circle><rect class="art-dim" x="20" y="32" width="96" height="8" rx="2"></rect><rect class="art-dim" x="124" y="32" width="44" height="8" rx="2"></rect></g>
            <g class="art-row"><circle class="art-node" cx="8" cy="60" r="3"></circle><rect class="art-dim" x="20" y="56" width="60" height="8" rx="2"></rect><rect class="art-dim" x="88" y="56" width="86" height="8" rx="2"></rect></g>
            <g class="art-row"><circle class="art-node" cx="8" cy="84" r="3"></circle><rect class="art-dim" x="20" y="80" width="84" height="8" rx="2"></rect><rect class="art-dim" x="112" y="80" width="50" height="8" rx="2"></rect></g>
          </g>
        </svg>
      </article>

      <article class="cell">
        <div class="cell-text">
          <h3 class="cell-title"><Image size={18} strokeWidth={1.75} />Images and files</h3>
          <p>Stored in your own bucket and linked from content.</p>
        </div>
        <svg class="cell-art art-media" viewBox="0 0 220 90" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
          <rect class="art-fill" x="1" y="6" width="100" height="78" rx="6"></rect>
          <path class="art-line" d="m12 70 24-26 18 18 12-12 26 20"></path>
          <circle class="art-line" cx="78" cy="26" r="7"></circle>
          <rect class="art-fill" x="112" y="6" width="50" height="36" rx="6"></rect>
          <rect class="art-fill" x="168" y="6" width="50" height="36" rx="6"></rect>
          <rect class="art-fill" x="112" y="48" width="106" height="36" rx="6"></rect>
        </svg>
      </article>

      <article class="cell cell-note">
        <h3 class="cell-title"><ShieldCheck size={18} strokeWidth={1.75} />Safe content</h3>
        <p>Content that tries to run code is refused, so an editor cannot break your server.</p>
      </article>
      <article class="cell cell-note">
        <h3 class="cell-title"><Blocks size={18} strokeWidth={1.75} />Forms, orders and comments</h3>
        <p>Add Postgres and Graft stores what your visitors send, with rate limits built in.</p>
      </article>
    </div>
  </div>
</section>
