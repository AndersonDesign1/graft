---
/**
 * The agents Graft works with, in a band of their own under the hero. A
 * light passes along the row, one agent at a time: any of them will do.
 */
import Mark from "./Mark.astro";
import { agents } from "./agents";
---

<section class="screen screen-short" id="works-with">
  <div class="wrap stack">
    <div class="stack-head" data-reveal>
      <h2 class="h2">Works with the agent you already use</h2>
      <p class="lead">
        Your content setup is plain TypeScript. If an agent can read that, it already knows how to
        use Graft. There is nothing new to teach it.
      </p>
    </div>
    <ul class="agent-row" style={`--count:${agents.length}`} data-reveal>
      {
        agents.map((agent, i) => (
          <li class="agent-tile" style={`--i:${i}`}>
            <Mark name={agent.mark} size={32} />
            {agent.name}
          </li>
        ))
      }
    </ul>
  </div>
</section>
