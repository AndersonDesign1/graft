---
/**
 * The hero: the claim over one wide window of the real Studio, shown whole.
 * The words arrive line by line and the tray peels up behind them, once, on
 * load.
 */
import Rings from "./Rings.astro";
import StudioFrame from "./StudioFrame.astro";

const lines = ["The native CMS", "for agents and humans"];

---

<section class="screen hero w-hero" data-enter>
  <div class="wrap w-hero-grid">
    <div class="w-hero-top">
      <div class="w-hero-copy">
        <h1 class="h1 w-h1">
          {
            lines.map((line, i) => (
              <span class="w-line" style={`--i:${i}`}>
                <span>{line}</span>
              </span>
            ))
          }
        </h1>
        <p class="lead">
          Graft is an open-source CMS where your agents and your content team work on the same
          content. Developers model it in code. Editors publish from a browser. Agents do the
          busywork.
</p>
        <div class="actions">
          <a class="btn btn-primary" href="/start">Get started</a>
          <button class="btn btn-ghost" type="button" data-agent-open>Set up with your agent</button>
        </div>
      </div>

    </div>
    <div class="tray w-hero-tray" data-peel>
      <Rings cx={50} cy={8} seed={4} rings={40} />
      <StudioFrame route="/c/pages/home" eager />
    </div>
  </div>
</section>

