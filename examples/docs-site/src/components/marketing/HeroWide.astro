---
/**
 * The hero: the claim over one wide window of the real Studio, shown whole.
 * The words arrive line by line and the tray peels up behind them, once, on
 * load.
 */
import Command from "./Command.astro";
import Rings from "./Rings.astro";
import StudioFrame from "./StudioFrame.astro";

const lines = ["The native CMS", "for agents and humans"];

/** The same words the "No code needed" section hands an agent. */
const prompt = "Set up a Graft site for me.";
---

<section class="screen hero w-hero" data-enter>
  <div class="wrap w-hero-grid">
    <div class="w-hero-top">
      <div class="w-hero-copy">
        <h1 class="h1 w-h1">
          {
            lines.map((line, i) => (
              <span class="w-line" style={`--i:${i}`}>
                <span>{line}</span>
              </span>
            ))
          }
        </h1>
        <p class="lead">
          Graft is an open-source CMS where your agents and your content team work on the same
          content. Developers model it in code. Editors publish from a browser. Agents do the
          busywork.
</p>
        <div class="actions">
          <a class="btn btn-primary" href="/start">Get started</a>
          <button class="btn btn-ghost" type="button" data-agent-open>Set up with your agent</button>
        </div>
      </div>

    </div>
    <dialog class="agent-dialog" aria-labelledby="agent-dialog-title" data-agent-dialog>
      <div class="agent-dialog-body">
        <h2 class="h3" id="agent-dialog-title">Set up Graft with your agent</h2>
        <p>
          Paste this into Claude Code, Codex, Cursor or any agent you use. It asks you three
          questions, then sets up your site and tells you what it did.
        </p>
        <Command command={prompt} />
        <form method="dialog" class="agent-dialog-actions">
          <button class="btn btn-ghost btn-small" type="submit">Close</button>
        </form>
      </div>
    </dialog>
    <div class="tray w-hero-tray" data-peel>
      <Rings cx={50} cy={8} seed={4} rings={40} />
      <StudioFrame route="/c/pages/home" />
    </div>
  </div>
</section>

<script>
  // The agent button opens the prompt in a dialog; a tap on the backdrop
  // closes it, as do Escape and the Close button.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-agent-dialog]")) {
    const opener = dialog.closest("section")?.querySelector<HTMLButtonElement>("[data-agent-open]");
    opener?.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
