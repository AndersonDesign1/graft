---
/**
 * What Graft works with: the agents people use, the frameworks, and where
 * it runs. Three belts of real marks drift past each other and stop under the pointer; with reduced
 * motion they rest as two wrapped rows.
 */
import {
  AstroIcon,
  DockerIcon,
  NextjsIcon,
  NuxtIcon,
  PostgresqlIcon,
  ReactIcon,
  SqliteIcon,
  SvelteIcon,
  TanstackIcon,
  TypescriptIcon,
} from "../icons/FrameworkIcons";
import Mark from "./Mark.astro";
import { agents } from "./agents";

const frameworks = [
  { name: "Next.js", Icon: NextjsIcon },
  { name: "Astro", Icon: AstroIcon },
  { name: "SvelteKit", Icon: SvelteIcon },
  { name: "Nuxt", Icon: NuxtIcon },
  { name: "TanStack Start", Icon: TanstackIcon },
  { name: "React Router", mark: "reactrouter" },
  { name: "React", Icon: ReactIcon },
  { name: "Vue", mark: "vuedotjs" },
  { name: "TypeScript", Icon: TypescriptIcon },
];
const places = [
  { name: "Vercel", mark: "vercel" },
  { name: "Netlify", mark: "netlify" },
  { name: "Cloudflare", mark: "cloudflare" },
  { name: "Railway", mark: "railway" },
  { name: "Fly.io", mark: "flydotio" },
  { name: "Docker", Icon: DockerIcon },
  { name: "Postgres", Icon: PostgresqlIcon },
  { name: "SQLite", Icon: SqliteIcon },
  { name: "Git", mark: "git" },
  { name: "MDX", mark: "mdx" },
  { name: "MCP", mark: "mcp" },
];
const belts = [
  { label: "Agents", items: agents.map((agent) => ({ name: agent.name, mark: agent.mark })) },
  { label: "Frameworks", items: frameworks },
  { label: "Hosting, data and formats", items: places },
];
---

<section class="screen screen-short" id="stack">
  <div class="wrap stack">
    <div class="stack-head" data-reveal>
      <h2 class="h2">Works with your agents and your stack</h2>
      <p class="lead">
        Graft is made of things you already run: MDX files, a TypeScript schema, Git, and Postgres
        when you need it. Your agent, your framework and your host already know what to do with
        them.
</p>
    </div>
    {
      belts.map((belt, b) => (
        <div class="belt" data-belt data-dir={b % 2 ? "back" : "forth"} aria-label={belt.label} role="group">
          {[0, 1, 2].map((copy) => (
            <ul class="belt-track" aria-hidden={copy > 0 ? "true" : undefined}>
              {belt.items.map((item) => (
                <li class="chip">
                  {"Icon" in item && item.Icon ? <item.Icon size={22} /> : <Mark name={item.mark ?? ""} size={22} />}
                  {item.name}
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))
    }
  </div>
</section>
