---
/**
 * Branching, as four steps a visitor can pick. The commands and their output
 * are the old landing page's, kept as written.
 */
import Rings from "./Rings.astro";

const steps = [
  {
    id: "create",
    label: "Create",
    title: "Start a branch. Nothing is copied.",
    body: "A branch starts in an instant and stays out of the way. It reads from the main content until it changes something.",
    lines: [
      ["cmd", "graft branch create preview"],
      ["ok", 'Created branch "preview" from "main"'],
      ["dim", "overlay, zero rows copied"],
    ],
  },
  {
    id: "edit",
    label: "Edit",
    title: "Change it on the branch.",
    body: "You or your agent edit and compile on the branch. Reviewers see the change; your live site does not.",
    lines: [
      ["cmd", "graft compile --branch preview"],
      ["ok", "pages/pricing     validated ✓"],
      ["out", "projected to content_index @ preview"],
      ["dim", "+0 added  ~1 changed  −0 removed"],
    ],
  },
  {
    id: "hide",
    label: "Remove",
    title: "Take a page away, only here.",
    body: "Deleting on a branch hides the page on that branch. The live copy is untouched until you merge.",
    lines: [
      ["out", 'delete_content({ slug: "changelog" })'],
      ["ok", "tombstone written on preview"],
      ["dim", "main.changelog still intact"],
    ],
  },
  {
    id: "merge",
    label: "Merge",
    title: "Check it first. Then land it.",
    body: "A merge shows what it would do before it does it. Then the content goes live and the branch is gone.",
    lines: [
      ["cmd", "graft merge preview --apply"],
      ["out", "Ledger: replaying 2 data_records onto main"],
      ["ok", "would recompile working tree → main"],
      ["dim", 'branch "preview" dropped'],
    ],
  },
];

/**
 * When each line appears, in ms. A command is typed out a character at a
 * time; its output follows a beat after the last key, one line at a time,
 * slow enough to read.
 */
const TYPE_MS = 38;
const timeline = (lines: string[][]) => {
  let at = 250;
  return lines.map(([kind = "out", text = ""]) => {
    const chars = kind === "cmd" ? text.length : 0;
    const delay = at;
    at += kind === "cmd" ? chars * TYPE_MS + 350 : 450;
    return { kind, text, delay, chars };
  });
};
---

<section class="screen" id="branching">
  <div class="wrap split branching" data-steps>
    <div class="split-text" data-reveal>
      <h2 class="h2">Branch content the way you branch code</h2>
      <p class="lead">
        Preview a campaign, a redesign or a big rewrite on a branch. Share it for review. Your live
        site stays as it is until you merge.
</p>
      <div class="step-tabs" role="tablist" aria-label="Branching steps">
        {
          steps.map((step, i) => (
            <button
              type="button"
              role="tab"
              id={`step-tab-${step.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`step-${step.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-step={step.id}
            >
              <span class="step-n">{i + 1}</span>
              {step.label}
              <span class="step-progress" aria-hidden="true" />
            </button>
          ))
        }
      </div>
      {
        steps.map((step, i) => (
          <div class="step-copy" data-step-copy={step.id} hidden={i !== 0}>
            <h3 class="h3">{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))
      }
      <a class="link" href="/docs/branching-previews">Read about branches and previews</a>
    </div>
    <div class="tray split-visual" data-peel>
      <Rings cx={70} cy={76} seed={27} />
      <div class="window terminal">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="window-title">Terminal</span>
        </div>
        {
          steps.map((step, i) => (
            <pre class="code step-term" id={`step-${step.id}`} role="tabpanel" aria-labelledby={`step-tab-${step.id}`} data-step-panel={step.id} hidden={i !== 0}><code>{timeline(step.lines).map(({ kind, text, delay, chars }) => (
              <span class={`term-line term-${kind}`} style={`--d:${delay};--c:${chars}`}>{kind === "cmd" ? <><span class="tk-p">$ </span><span class="cli-bin">graft</span>{text.slice(5)}</> : text}{"\n"}</span>
            ))}</code></pre>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // The steps play through on their own, one every few seconds, while the
  // section is on screen. Each tab carries its own progress line, and the
  // end of that line is what moves to the next step, so pausing the line
  // (pointer over the section, or keyboard focus in it) pauses the tour.
  // Picking a step by hand stops the tour for good.
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const group of document.querySelectorAll<HTMLElement>("[data-steps]")) {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const on = other === tab;
        const id = other.dataset.step;
        other.setAttribute("aria-selected", String(on));
        other.tabIndex = on ? 0 : -1;
        for (const el of group.querySelectorAll<HTMLElement>(
          `[data-step-copy="${id}"], [data-step-panel="${id}"]`,
        )) {
          el.hidden = !on;
        }
      }
    };
    const stop = () => delete group.dataset.auto;
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        stop();
        select(tab);
      });
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        stop();
        const next = tabs[(i + step + tabs.length) % tabs.length]!;
        select(next);
        next.focus();
      });
      tab.querySelector(".step-progress")?.addEventListener("animationend", () => {
        if (group.dataset.auto === undefined) return;
        select(tabs[(i + 1) % tabs.length]!);
      });
    });
    if (calm) continue;
    new IntersectionObserver(
      ([entry]) => {
        if (group.dataset.picked) return;
        if (entry?.isIntersecting) group.dataset.auto = "";
        else stop();
      },
      { threshold: 0.5 },
    ).observe(group);
    for (const tab of tabs) tab.addEventListener("click", () => (group.dataset.picked = "true"));
  }
</script>

