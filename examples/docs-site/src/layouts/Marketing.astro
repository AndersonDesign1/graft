---
/**
 * The shell for graft.page's marketing pages: the landing page, Agents,
 * Studio, Start, Why and Security. Docs have their own shell.
 *
 * The pages work in both schemes. The page stamps `data-theme` before first
 * paint: the visitor's choice if they made one, otherwise their system's.
 */
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/marketing.css";
import Mark from "../components/marketing/Mark.astro";

interface Props {
  title: string;
  description: string;
  variant: "landing" | "page";
}

const { title, description, variant } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://graft.page").href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = localStorage.getItem("graft-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (_) {
        /* private mode: the system scheme stands */
      }
      // Entrances only run where motion is welcome and script is on, so a
      // page without either is simply complete.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
      }
      // The styles key off data-theme, so a page that follows the system
      // scheme resolves it here, before first paint.
      if (!document.documentElement.dataset.theme) {
        document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body class="lab" data-variant={variant}>
    <a class="lab-skip" href="#main">Skip to content</a>
    <header class="lab-nav">
      <nav class="wrap lab-nav-row" aria-label="Main">
        <a class="lab-wordmark" href="/">graft.</a>
        <ul class="lab-nav-links">
          <li><a href="/agents" aria-current={Astro.url.pathname.startsWith("/agents") ? "page" : undefined}>Agents</a></li>
          <li><a href="/studio" aria-current={Astro.url.pathname.startsWith("/studio") ? "page" : undefined}>Studio</a></li>
          <li><a href="/docs">Docs</a></li>
          <li><a href="/why" aria-current={Astro.url.pathname.startsWith("/why") ? "page" : undefined}>Why Graft</a></li>
          <li><a href="/security" aria-current={Astro.url.pathname.startsWith("/security") ? "page" : undefined}>Security</a></li>
        </ul>
        <a class="lab-nav-github" href="https://github.com/AndersonDesign1/graft" aria-label="Graft on GitHub">
          <Mark name="github" size={18} />
        </a>
        <a class="btn btn-primary btn-small" href="/start">Get started</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="closing">
      <div class="wrap closing-grid">
        <slot name="closing">
        <div class="closing-lead">
          <h2 class="h2">Start with one command</h2>
          <p class="lead">
            It writes <code>graft.config.ts</code> and your first MDX document into the repo you
            already have. No account, and no database until you want one.
          </p>
          <div class="actions">
            <button class="btn btn-command" type="button" data-copy="npx @usegraft/cli@latest init">
              <span class="btn-command-text">npx @usegraft/cli@latest init</span>
              <svg
                class="icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="14" height="14" x="8" y="8" rx="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span class="visually-hidden" aria-live="polite"></span>
            </button>
            <a class="btn btn-ghost" href="/docs/getting-started">Read the guide</a>
          </div>
        </div>
        </slot>
        <div class="closing-links">
          <ul>
            <li><a href="/docs/what-is-graft">What is Graft</a></li>
            <li><a href="/docs/the-model">How Graft works</a></li>
            <li><a href="/docs/studio">Studio</a></li>
            <li><a href="/docs/agent-surface">Agents and MCP</a></li>
          </ul>
          <ul>
            <li><a href="/docs/next">Next.js</a></li>
            <li><a href="/docs/astro">Astro</a></li>
            <li><a href="/docs/sveltekit">SvelteKit</a></li>
            <li><a href="/docs/tanstack-start">TanStack Start</a></li>
          </ul>
          <ul>
            <li><a href="https://github.com/AndersonDesign1/graft">GitHub</a></li>
            <li><a href="/docs/changelog">Changelog</a></li>
            <li><a href="/security">Security</a></li>
            <li><a href="/why">Why Graft</a></li>
          </ul>
        </div>
        <p class="closing-legal">
          <span class="lab-wordmark">graft.</span>
          <span>Open source under the MIT license.</span>
          <button type="button" class="closing-theme" data-theme-toggle>
            <span data-theme-label>Dark mode</span>
          </button>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;

      // Theme: the toggle wins from then on and tells any Studio frame.
      const label = document.querySelector<HTMLElement>("[data-theme-label]");
      const paint = () => {
        if (label) label.textContent = root.dataset.theme === "dark" ? "Light mode" : "Dark mode";
      };
      paint();

      // The page follows the system scheme live until the toggle is used.
      const system = matchMedia("(prefers-color-scheme: dark)");
      system.addEventListener("change", () => {
        let chosen = null;
        try {
          chosen = localStorage.getItem("graft-theme");
        } catch {
          /* private mode: no stored choice to respect */
        }
        if (chosen) return;
        root.dataset.theme = system.matches ? "dark" : "light";
        paint();
        document.dispatchEvent(new CustomEvent("graft:theme", { detail: root.dataset.theme }));
      });

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        // A scheme change is not something to animate: every color on the
        // page would cross-fade at once.
        root.dataset.switching = "";
        root.dataset.theme = next;
        requestAnimationFrame(() => requestAnimationFrame(() => delete root.dataset.switching));
        try {
          localStorage.setItem("graft-theme", next);
        } catch {
          /* private mode: the choice lasts until the next navigation */
        }
        paint();
        document.dispatchEvent(new CustomEvent("graft:theme", { detail: next }));
      });

      // Sections arrive once, the first time they are seen: text rises and
      // a tray peels up from its lower edge.
      // A peeling tray starts fully clipped, and a clipped box never counts
      // as seen, so its parent is watched in its place.
      const watched = new Map<Element, Element[]>();
      const arrive = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const el of watched.get(entry.target) ?? []) el.setAttribute("data-in", "");
            arrive.unobserve(entry.target);
          }
        },
        { threshold: 0.12 },
      );
      for (const el of document.querySelectorAll("[data-reveal], [data-peel]")) {
        const seen = el.hasAttribute("data-peel") ? (el.parentElement ?? el) : el;
        watched.set(seen, [...(watched.get(seen) ?? []), el]);
        arrive.observe(seen);
      }

      // Copy buttons keep their label and say the result through a live region.
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          const live = button.querySelector("[aria-live]");
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            button.dataset.copied = "true";
            if (live) live.textContent = "Copied";
          } catch {
            if (live) live.textContent = "Copy failed";
          }
          setTimeout(() => {
            delete button.dataset.copied;
            if (live) live.textContent = "";
          }, 2000);
        });
      }

      // Questions open and close by their height, so an answer slides in
      // under its question instead of snapping. Without script, or with
      // reduced motion, the browser's own one-open-at-a-time details stand.
      if (root.classList.contains("motion")) {
        const all = [...document.querySelectorAll<HTMLDetailsElement>(".faq-list details")];
        // The group is kept by hand: a shared name would close the other
        // answer at once, before it could slide shut.
        for (const details of all) {
          details.dataset.group = details.name;
          details.removeAttribute("name");
        }
        const isOpen = (details: HTMLDetailsElement) =>
          details.open && details.dataset.closing === undefined;
        const move = (details: HTMLDetailsElement, open: boolean) => {
          const body = details.querySelector<HTMLElement>(".faq-a");
          if (!body) {
            details.open = open;
            return;
          }
          const from = details.open ? body.getBoundingClientRect().height : 0;
          for (const running of body.getAnimations()) running.cancel();
          details.open = true;
          const to = open ? body.scrollHeight : 0;
          if (open) delete details.dataset.closing;
          else details.dataset.closing = "";
          const slide = body.animate(
            [
              { height: `${from}px`, opacity: open && from === 0 ? 0 : 1 },
              { height: `${to}px`, opacity: open ? 1 : 0 },
            ],
            { duration: 280, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
          );
          slide.addEventListener("finish", () => {
            if (open) return;
            details.open = false;
            delete details.dataset.closing;
          });
        };
        for (const details of all) {
          details.querySelector("summary")?.addEventListener("click", (event) => {
            event.preventDefault();
            const opening = !isOpen(details);
            if (opening) {
              for (const other of all) {
                if (other !== details && other.dataset.group === details.dataset.group && isOpen(other))
                  move(other, false);
              }
            }
            move(details, opening);
          });
        }
      }

      // The nav takes a ground once the page has moved under it.
      const nav = document.querySelector(".lab-nav");
      const onScroll = () => nav?.toggleAttribute("data-scrolled", window.scrollY > 8);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
