---
/**
 * The shell for graft.page's marketing pages: the landing page, Agents,
 * Studio, Start, Why and Security. Docs have their own shell.
 *
 * The pages work in both schemes. The page stamps `data-theme` before first
 * paint: the visitor's choice if they made one, otherwise their system's.
 */
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/marketing.css";
import AgentSetup from "../components/marketing/AgentSetup.astro";
import { cardFor } from "../lib/marketing-cards";
import Mark from "../components/marketing/Mark.astro";

interface Props {
  title: string;
  description: string;
  variant: "landing" | "page";
}

const { title, description, variant } = Astro.props;

// The page's address and its social card, for search results and shares.
const canonical = new URL(Astro.url.pathname, "https://graft.page").href;
const ogImage = new URL(`/og/site/${cardFor(Astro.url.pathname)}.png`, "https://graft.page").href;

// The nav's links, shared by the bar on wide screens and the menu on narrow
// ones. Docs is its own site, so it is never the current page here.
const links = [
  { href: "/agents", label: "Agents" },
  { href: "/studio", label: "Studio" },
  { href: "/docs", label: "Docs" },
  { href: "/why", label: "Why Graft" },
  { href: "/security", label: "Security" },
].map((link) => ({
  ...link,
  current: link.href !== "/docs" && Astro.url.pathname.startsWith(link.href),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Graft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = localStorage.getItem("graft-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (_) {
        /* private mode: the system scheme stands */
      }
      // Entrances only run where motion is welcome and script is on, so a
      // page without either is simply complete.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        // If the page's script never runs, nothing would arrive: show it all.
        setTimeout(() => {
          if (!("ready" in document.documentElement.dataset)) {
            document.documentElement.classList.remove("motion");
          }
        }, 4000);
      }
      // The styles key off data-theme, so a page that follows the system
      // scheme resolves it here, before first paint.
      if (!document.documentElement.dataset.theme) {
        document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body class="lab" data-variant={variant}>
    <a class="lab-skip" href="#main">Skip to content</a>
    <header class="lab-nav">
      <nav class="wrap lab-nav-row" aria-label="Main">
        <a class="lab-wordmark" href="/">graft.</a>
        <ul class="lab-nav-links">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="lab-nav-github" href="https://github.com/AndersonDesign1/graft" aria-label="Graft on GitHub">
          <Mark name="github" size={18} />
        </a>
        <button
          type="button"
          class="lab-nav-menu"
          aria-expanded="false"
          aria-controls="nav-panel"
          data-nav-menu
        >
          Menu
        </button>
        <a class="btn btn-primary btn-small" href="/start">Get started</a>
      </nav>
      <div class="lab-nav-panel" id="nav-panel" hidden>
        <ul class="wrap">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="closing">
      <div class="wrap closing-grid">
        <slot name="closing">
        <div class="closing-lead">
          <h2 class="h2">Set up Graft with your agent</h2>
          <p class="lead">
            Paste one sentence into the agent you use. It asks three questions, then sets up your
            site, your editor and a database if you want one.
          </p>
          <div class="actions">
            <button class="btn btn-primary" type="button" data-agent-open>Set up with your agent</button>
            <a class="btn btn-ghost" href="/docs/getting-started">Read the guide</a>
          </div>
        </div>
        </slot>
        <div class="closing-links">
          <ul>
            <li><a href="/docs/what-is-graft">What is Graft</a></li>
            <li><a href="/docs/the-model">How Graft works</a></li>
            <li><a href="/docs/studio">Studio</a></li>
            <li><a href="/docs/agent-surface">Agents and MCP</a></li>
          </ul>
          <ul>
            <li><a href="/docs/next">Next.js</a></li>
            <li><a href="/docs/astro">Astro</a></li>
            <li><a href="/docs/sveltekit">SvelteKit</a></li>
            <li><a href="/docs/tanstack-start">TanStack Start</a></li>
          </ul>
          <ul>
            <li><a href="https://github.com/AndersonDesign1/graft">GitHub</a></li>
            <li><a href="/docs/changelog">Changelog</a></li>
            <li><a href="/security">Security</a></li>
            <li><a href="/why">Why Graft</a></li>
          </ul>
        </div>
        <p class="closing-legal">
          <span class="lab-wordmark">graft.</span>
          <span>Open source under the MIT license.</span>
          <span class="theme-switch" role="radiogroup" aria-label="Color scheme" data-theme-switch>
            <button type="button" role="radio" aria-checked="false" aria-label="System" title="System" data-theme-choice="system">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
            </button>
            <button type="button" role="radio" aria-checked="false" aria-label="Light" title="Light" data-theme-choice="light">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
            </button>
            <button type="button" role="radio" aria-checked="false" aria-label="Dark" title="Dark" data-theme-choice="dark">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            </button>
          </span>
        </p>
      </div>
    </footer>
    <AgentSetup />

    <script>
      const root = document.documentElement;

      // Theme: System follows the OS and is the default. Light or Dark is
      // remembered and wins from then on. Every change tells any Studio frame.
      const system = matchMedia("(prefers-color-scheme: dark)");
      const choices = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")];
      const stored = () => {
        try {
          const t = localStorage.getItem("graft-theme");
          return t === "light" || t === "dark" ? t : "system";
        } catch {
          return "system"; // private mode: nothing stored
        }
      };
      const apply = (choice: string) => {
        const next = choice === "system" ? (system.matches ? "dark" : "light") : choice;
        if (root.dataset.theme !== next) {
          // A scheme change is not something to animate: every color on the
          // page would cross-fade at once.
          root.dataset.switching = "";
          root.dataset.theme = next;
          requestAnimationFrame(() => requestAnimationFrame(() => delete root.dataset.switching));
          document.dispatchEvent(new CustomEvent("graft:theme", { detail: next }));
        }
        for (const button of choices) {
          const on = button.dataset.themeChoice === choice;
          button.setAttribute("aria-checked", String(on));
          button.tabIndex = on ? 0 : -1;
        }
      };
      apply(stored());
      system.addEventListener("change", () => {
        if (stored() === "system") apply("system");
      });
      choices.forEach((button, i) => {
        button.addEventListener("click", () => {
          const choice = button.dataset.themeChoice ?? "system";
          try {
            if (choice === "system") localStorage.removeItem("graft-theme");
            else localStorage.setItem("graft-theme", choice);
          } catch {
            /* private mode: the choice lasts until the next navigation */
          }
          apply(choice);
        });
        button.addEventListener("keydown", (event) => {
          const step = ["ArrowRight", "ArrowDown"].includes(event.key)
            ? 1
            : ["ArrowLeft", "ArrowUp"].includes(event.key)
              ? -1
              : 0;
          if (!step) return;
          event.preventDefault();
          const next = choices[(i + step + choices.length) % choices.length]!;
          next.focus();
          next.click();
        });
      });

      // Sections arrive once, the first time they are seen: text rises and
      // a tray peels up from its lower edge.
      // A peeling tray starts fully clipped, and a clipped box never counts
      // as seen, so its parent is watched in its place.
      const watched = new Map<Element, Element[]>();
      const arrive = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const el of watched.get(entry.target) ?? []) el.setAttribute("data-in", "");
            arrive.unobserve(entry.target);
          }
        },
        { threshold: 0.12 },
      );
      for (const el of document.querySelectorAll("[data-reveal], [data-peel]")) {
        const seen = el.hasAttribute("data-peel") ? (el.parentElement ?? el) : el;
        watched.set(seen, [...(watched.get(seen) ?? []), el]);
        arrive.observe(seen);
      }

      // Loops run only while they are on screen.
      const onscreen = new IntersectionObserver((entries) => {
        for (const entry of entries) entry.target.toggleAttribute("data-onscreen", entry.isIntersecting);
      });
      for (const el of document.querySelectorAll(".belt, .bento, .composer, .b-hero")) {
        onscreen.observe(el);
      }
      root.dataset.ready = "";

      // Copy buttons keep their label and say the result through a live region.
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          const live = button.querySelector("[aria-live]");
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            button.dataset.copied = "true";
            if (live) live.textContent = "Copied";
          } catch {
            if (live) live.textContent = "Copy failed";
          }
          setTimeout(() => {
            delete button.dataset.copied;
            if (live) live.textContent = "";
          }, 2000);
        });
      }

      // Questions open and close by their height, so an answer slides in
      // under its question instead of snapping. Without script, or with
      // reduced motion, the browser's own one-open-at-a-time details stand.
      if (root.classList.contains("motion")) {
        const all = [...document.querySelectorAll<HTMLDetailsElement>(".faq-list details")];
        // The group is kept by hand: a shared name would close the other
        // answer at once, before it could slide shut.
        for (const details of all) {
          details.dataset.group = details.name;
          details.removeAttribute("name");
        }
        const isOpen = (details: HTMLDetailsElement) =>
          details.open && details.dataset.closing === undefined;
        const move = (details: HTMLDetailsElement, open: boolean) => {
          const body = details.querySelector<HTMLElement>(".faq-a");
          if (!body) {
            details.open = open;
            return;
          }
          const from = details.open ? body.getBoundingClientRect().height : 0;
          for (const running of body.getAnimations()) running.cancel();
          details.open = true;
          const to = open ? body.scrollHeight : 0;
          if (open) delete details.dataset.closing;
          else details.dataset.closing = "";
          const slide = body.animate(
            [
              { height: `${from}px`, opacity: open && from === 0 ? 0 : 1 },
              { height: `${to}px`, opacity: open ? 1 : 0 },
            ],
            { duration: 280, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
          );
          slide.addEventListener("finish", () => {
            if (open) return;
            details.open = false;
            delete details.dataset.closing;
          });
        };
        for (const details of all) {
          details.querySelector("summary")?.addEventListener("click", (event) => {
            event.preventDefault();
            const opening = !isOpen(details);
            if (opening) {
              for (const other of all) {
                if (other !== details && other.dataset.group === details.dataset.group && isOpen(other))
                  move(other, false);
              }
            }
            move(details, opening);
          });
        }
      }

      // The menu on narrow screens: a panel under the bar that slides down.
      // A link, Escape, a tap outside or a wider window closes it.
      const menuButton = document.querySelector<HTMLButtonElement>("[data-nav-menu]");
      const panel = document.getElementById("nav-panel");
      const header = document.querySelector<HTMLElement>(".lab-nav");
      if (menuButton && panel && header) {
        const setMenu = (open: boolean) => {
          if (open === (menuButton.getAttribute("aria-expanded") === "true")) return;
          menuButton.setAttribute("aria-expanded", String(open));
          menuButton.textContent = open ? "Close" : "Menu";
          header.toggleAttribute("data-menu", open);
          for (const running of panel.getAnimations()) running.cancel();
          if (open) panel.hidden = false;
          if (!root.classList.contains("motion")) {
            panel.hidden = !open;
            return;
          }
          const slide = panel.animate(
            [
              { opacity: 0, transform: "translateY(-0.5rem)" },
              { opacity: 1, transform: "none" },
            ],
            {
              duration: open ? 220 : 160,
              easing: "cubic-bezier(0.23, 1, 0.32, 1)",
              direction: open ? "normal" : "reverse",
            },
          );
          if (!open) slide.addEventListener("finish", () => (panel.hidden = true));
        };
        menuButton.addEventListener("click", () =>
          setMenu(menuButton.getAttribute("aria-expanded") !== "true"),
        );
        panel.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a")) setMenu(false);
        });
        addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || menuButton.getAttribute("aria-expanded") !== "true") return;
          setMenu(false);
          menuButton.focus();
        });
        document.addEventListener("click", (event) => {
          if (!header.contains(event.target as Node)) setMenu(false);
        });
        matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
          if (event.matches) setMenu(false);
        });
      }

      // The nav takes a ground once the page has moved under it.
      const nav = document.querySelector(".lab-nav");
      const onScroll = () => nav?.toggleAttribute("data-scrolled", window.scrollY > 8);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
