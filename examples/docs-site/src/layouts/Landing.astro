---
/**
 * Landing shell — "the proof sheet." Dark always (data-theme="dark" beats the
 * OS setting via tokens.css); fixed translucent nav with a wide dropdown; a
 * grain overlay to give the black stage some material; colophon footer.
 *
 * The dropdown is built from the *content index* — the same typed read the
 * docs sidebar uses — so the menu is generated by the CMS the site is
 * demonstrating. Nothing in it is hand-maintained.
 *
 * Nav/menu/reveal are a few lines of vanilla JS — islands are reserved for the
 * sections that are truly interactive.
 */
import "@fontsource/instrument-serif";
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/landing.css";
import { docsNav } from "../lib/nav";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Three columns, from the real docs tree. Sections beyond the third live in
// the sidebar; the menu is a doorway, not a mirror.
const menu = (await docsNav()).slice(0, 3).map((section) => ({
  ...section,
  entries: section.entries.slice(0, 3),
}));
const featured = menu[0]?.entries[0];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="landing-nav" id="landing-nav">
      <nav class="landing-nav-inner" aria-label="Main">
        <a href="/" class="landing-wordmark">graft<b>.</b></a>

        {/*
          The label is a real link — a nav item with a menu is still a
          destination, so clicking "Docs" goes to /docs. The chevron is a
          separate control that only opens the panel, which also gives keyboard
          and touch users a way in without hijacking the link.
        */}
        <div class="nav-menu" id="nav-menu">
          <a href="/docs" class="nav-trigger">Docs</a>
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="Open docs menu"
          >
            <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
          </button>

          <div class="nav-panel" id="nav-panel" hidden>
            <div class="nav-panel-grid">
              {
                menu.map((section) => (
                  <div class="nav-col">
                    <p class="nav-col-label">{section.section}</p>
                    {section.entries.map((entry) => (
                      <a href={`/docs/${entry.slug}`} class="nav-link">
                        <span class="nav-link-title">{entry.title}</span>
                      </a>
                    ))}
                  </div>
                ))
              }
            </div>
            <div class="nav-panel-foot">
              {
                featured && (
                  <p>
                    <b>Start here:</b> {featured.title}
                  </p>
                )
              }
              <a href="/docs">All docs →</a>
            </div>
          </div>
        </div>

        <a href="/docs/agent-surface" data-secondary>Agents</a>
        <a href="/docs/cli-reference" data-secondary>CLI</a>
        <a href="#start" class="nav-cta">Start</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <div>
          <h4>colophon</h4>
          <p>
            Set in Instrument Serif &amp; Sans with IBM Plex Mono. A black stage, off-white type,
            and no accent at all — the code is the only colored thing on the page.
          </p>
        </div>
        <div>
          <h4>how this page exists</h4>
          <p>
            Copy lives in <code>content/</code> as MDX, validated by a Zod schema, compiled to
            <code>content_index</code>, rendered by typed reads. Git is authoritative; the
            database is derived. Even the menu above is a typed read.
          </p>
        </div>
        <div>
          <h4>for agents</h4>
          <p>
            <a href="/llms.txt">llms.txt</a> · MCP at <code>POST /api/mcp</code> · functions at
            <code>POST /api/fn/&lt;name&gt;</code>. Errors carry their own fix.
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Nav hairline once content scrolls under it. rAF-coalesced.
      const nav = document.getElementById("landing-nav");
      let raf = 0;
      const update = () => {
        raf = 0;
        if (nav) nav.dataset.scrolled = String(window.scrollY > 8);
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      update();
      addEventListener("scroll", onScroll, { passive: true });

      // Wide dropdown. Pointer opens on hover (with a close delay so the
      // diagonal trip from trigger to panel doesn't drop it); keyboard opens
      // on click/Enter and closes on Escape. Focus stays in the DOM order.
      const menu = document.getElementById("nav-menu");
      const trigger = document.getElementById("nav-toggle");
      const panel = document.getElementById("nav-panel");
      if (menu && trigger && panel) {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;
        const setOpen = (open: boolean) => {
          clearTimeout(closeTimer);
          trigger.setAttribute("aria-expanded", String(open));
          if (open) {
            panel.hidden = false;
            // Flush the un-hidden state so the transition has a start value.
            // (rAF would be starved in a background/throttled tab, which would
            // leave the panel visible-but-opacity-0 — i.e. an empty menu.)
            void panel.offsetHeight;
            panel.setAttribute("data-open", "true");
          } else {
            panel.removeAttribute("data-open");
            // wait out the exit transition before pulling it from the a11y tree
            closeTimer = setTimeout(() => {
              panel.hidden = true;
            }, 200);
          }
        };
        const isOpen = () => trigger.getAttribute("aria-expanded") === "true";

        const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (fine) {
          menu.addEventListener("mouseenter", () => setOpen(true));
          menu.addEventListener("mouseleave", () => {
            clearTimeout(closeTimer);
            closeTimer = setTimeout(() => setOpen(false), 120);
          });
        }
        trigger.addEventListener("click", () => setOpen(!isOpen()));
        addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            trigger.focus();
          }
        });
        // click-away + focus-away
        addEventListener("click", (e) => {
          if (isOpen() && !menu.contains(e.target as Node)) setOpen(false);
        });
        menu.addEventListener("focusout", (e) => {
          if (!menu.contains(e.relatedTarget as Node)) setOpen(false);
        });
      }

      // Shared one-shot reveal: static section headers opt in with .reveal.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "-80px" },
      );
      for (const el of document.querySelectorAll(".reveal")) io.observe(el);
    </script>
  </body>
</html>
