---
/**
 * Landing shell — "the proof sheet." Dark always (data-theme="dark" beats the
 * OS setting via tokens.css); fixed translucent nav with a wide dropdown; a
 * multi-column footer
 * built from the same docs index the nav uses.
 *
 * The dropdown is built from the *content index* — the same typed read the
 * docs sidebar uses — so the menu is generated by the CMS the site is
 * demonstrating. Nothing in it is hand-maintained.
 *
 * Nav/menu/reveal are a few lines of vanilla JS — islands are reserved for the
 * sections that are truly interactive.
 */
import "@fontsource/instrument-serif";
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/landing.css";
import { PoweredByGraft } from "../components/powered-by-graft";
import { docsNav } from "../lib/nav";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const nav = await docsNav();

// Three columns, from the real docs tree. Sections beyond the third live in
// the sidebar; the menu is a doorway, not a mirror.
const menu = nav.slice(0, 3).map((section) => ({
  ...section,
  entries: section.entries.slice(0, 3),
}));
const featured = menu[0]?.entries[0];

// Footer columns — more of the tree, still generated, still typed.
const footerDocs = nav.slice(0, 4).map((section) => ({
  ...section,
  entries: section.entries.slice(0, 4),
}));
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="landing-nav" id="landing-nav">
      <nav class="landing-nav-inner" aria-label="Main">
        {/* The badge is a link, not a tooltip. "beta" raises a question and the
            answer is a paragraph, so it points at the page holding it — and a
            title attribute would hide that answer from every touchscreen. */}
        <div class="brand">
          <a href="/" class="landing-wordmark">graft<b>.</b></a>
          <a href="/docs/getting-started" class="beta-badge">beta</a>
        </div>

        {/*
          The label is a real link — a nav item with a menu is still a
          destination, so clicking "Docs" goes to /docs. The chevron is a
          separate control that only opens the panel, which also gives keyboard
          and touch users a way in without hijacking the link.
        */}
        <div class="nav-menu" id="nav-menu">
          <a href="/docs" class="nav-trigger">Docs</a>
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="Open docs menu"
          >
            <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
          </button>

          <div class="nav-panel" id="nav-panel" hidden>
            <div class="nav-panel-grid">
              {
                menu.map((section) => (
                  <div class="nav-col">
                    <p class="nav-col-label">{section.section}</p>
                    {section.entries.map((entry) => (
                      <a href={`/docs/${entry.slug}`} class="nav-link">
                        <span class="nav-link-title">{entry.title}</span>
                      </a>
                    ))}
                  </div>
                ))
              }
            </div>
            <div class="nav-panel-foot">
              {
                featured && (
                  <p>
                    <b>Start here:</b> {featured.title}
                  </p>
                )
              }
              <a href="/docs">All docs →</a>
            </div>
          </div>
        </div>

        <a href="/why" data-secondary>Why</a>
        <a href="/security" data-secondary>Security</a>
        <a href="/docs/agent-surface" data-secondary>Agents</a>
        <a href="/docs/cli-reference" data-secondary>CLI</a>
        <a
          href="https://github.com/AndersonDesign1/graft"
          class="nav-github"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
        </a>
        <a href="#start" class="nav-cta">Start</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="landing-footer">
      <div class="landing-footer-inner">
        <div class="footer-brand">
          <a href="/" class="landing-wordmark">graft<b>.</b></a>
          <p>Open-source, self-hostable CMS. Content as code for you and your agent.</p>
        </div>

        <div class="footer-col">
          <h4>Product</h4>
          <ul>
            <li><a href="/why">Why Graft</a></li>
            <li><a href="/security">Security</a></li>
            <li><a href="#branching">Branching</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#start">Start</a></li>
          </ul>
        </div>

        {
          footerDocs.slice(0, 2).map((section) => (
            <div class="footer-col">
              <h4>{section.section}</h4>
              <ul>
                {section.entries.map((entry) => (
                  <li>
                    <a href={`/docs/${entry.slug}`}>{entry.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="footer-col">
          <h4>Agents</h4>
          <ul>
            <li><a href="/docs/what-is-graft">What is Graft</a></li>
            <li><a href="/docs/agent-surface">MCP surface</a></li>
            <li><a href="/docs/cli-reference">CLI reference</a></li>
            <li><a href="/docs/deploy">Self-host</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bar">
        <p>Open source · Self-hostable · Git authoritative</p>
        <PoweredByGraft />
      </div>
    </footer>

    <script>
      // Nav hairline once content scrolls under it; hero scroll-cue fades on
      // the first step. Both rAF-coalesced on the same scroll listener.
      const nav = document.getElementById("landing-nav");
      const cue = document.querySelector<HTMLElement>(".scroll-cue");
      let raf = 0;
      let cueFaded = false;
      const update = () => {
        raf = 0;
        const y = window.scrollY;
        if (nav) nav.dataset.scrolled = String(y > 8);
        if (!cueFaded && cue && y > 24) {
          cue.dataset.faded = "true";
          cueFaded = true;
        }
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      // Seeding the initial state through rAF, not by calling update() here.
      // This script runs during parse, and reading window.scrollY is a layout
      // read: the browser has to lay out everything parsed so far before it can
      // answer. A trace put that single call at 75ms with 604 dirty objects —
      // the largest forced reflow on the page, and the only one caused by our
      // own code rather than by first render.
      //
      // The cost is that a page restored mid-scroll shows the nav without its
      // hairline for one frame. The alternative was blocking parse to avoid it.
      raf = requestAnimationFrame(update);
      addEventListener("scroll", onScroll, { passive: true });

      // Wide dropdown. Pointer opens on hover (with a close delay so the
      // diagonal trip from trigger to panel doesn't drop it); keyboard opens
      // on click/Enter and closes on Escape. Focus stays in the DOM order.
      const menu = document.getElementById("nav-menu");
      const trigger = document.getElementById("nav-toggle");
      const panel = document.getElementById("nav-panel");
      if (menu && trigger && panel) {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;
        const setOpen = (open: boolean) => {
          clearTimeout(closeTimer);
          trigger.setAttribute("aria-expanded", String(open));
          if (open) {
            panel.hidden = false;
            // Flush the un-hidden state so the transition has a start value.
            // (rAF would be starved in a background/throttled tab, which would
            // leave the panel visible-but-opacity-0 — i.e. an empty menu.)
            void panel.offsetHeight;
            panel.setAttribute("data-open", "true");
          } else {
            panel.removeAttribute("data-open");
            // wait out the exit transition before pulling it from the a11y tree
            closeTimer = setTimeout(() => {
              panel.hidden = true;
            }, 200);
          }
        };
        const isOpen = () => trigger.getAttribute("aria-expanded") === "true";

        const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (fine) {
          menu.addEventListener("mouseenter", () => setOpen(true));
          menu.addEventListener("mouseleave", () => {
            clearTimeout(closeTimer);
            closeTimer = setTimeout(() => setOpen(false), 120);
          });
        }
        trigger.addEventListener("click", () => setOpen(!isOpen()));
        addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            trigger.focus();
          }
        });
        // click-away + focus-away
        addEventListener("click", (e) => {
          if (isOpen() && !menu.contains(e.target as Node)) setOpen(false);
        });
        menu.addEventListener("focusout", (e) => {
          if (!menu.contains(e.relatedTarget as Node)) setOpen(false);
        });
      }

      // Shared one-shot reveal: static section headers opt in with .reveal.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "-80px" },
      );
      for (const el of document.querySelectorAll(".reveal")) io.observe(el);
    </script>
  </body>
</html>
