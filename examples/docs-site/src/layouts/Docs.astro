---
/**
 * Docs shell: the Base chrome plus a section sidebar. The sidebar reads the
 * same content index as the pages it links — one source of truth, no
 * hand-maintained nav file to drift.
 */
import Base from "./Base.astro";
import { docsNav } from "../lib/nav";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const nav = await docsNav();
const current = Astro.url.pathname.replace(/\/$/, "");
---

<Base title={title} description={description}>
  <div class="docs-shell">
    <nav class="docs-sidebar" aria-label="Documentation">
      {
        nav.map(({ section, entries }) => (
          <section>
            <h2 class="label">{section}</h2>
            <ul>
              {entries.map((entry) => {
                const href = `/docs/${entry.slug}`;
                return (
                  <li>
                    <a href={href} aria-current={current === href ? "page" : undefined}>
                      {entry.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </nav>
    <div class="docs-content">
      <slot />
    </div>
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-8);
    max-width: 72rem;
  }

  .docs-sidebar {
    border-inline-end: 1px solid var(--hairline);
    padding: var(--space-8) var(--space-6) var(--space-8) var(--space-8);
    align-self: start;
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
  }

  .docs-sidebar section + section {
    margin-block-start: var(--space-6);
  }

  .docs-sidebar ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .docs-sidebar a {
    display: block;
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    margin-inline-start: calc(-1 * var(--space-2));
    border-radius: var(--radius-inner);
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .docs-sidebar a:hover {
      color: var(--color-fg);
      background: var(--paper-sunken);
    }
  }

  .docs-sidebar a[aria-current="page"] {
    color: var(--color-fg);
    background: var(--paper-sunken);
    /* The graft mark: the current page is the scion on the stock. */
    box-shadow: inset 2px 0 0 var(--wax);
  }

  .docs-content {
    padding: var(--space-12) var(--space-8) var(--space-16) 0;
    min-width: 0;
  }

  @media (max-width: 52rem) {
    .docs-shell {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: static;
      max-height: none;
      border-inline-end: none;
      border-block-end: 1px solid var(--hairline);
      padding: var(--space-6) var(--space-8);
    }

    .docs-content {
      padding: var(--space-8);
    }
  }
</style>
