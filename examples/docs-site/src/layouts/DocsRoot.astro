---
/**
 * Minimal HTML shell for the fumadocs docs pages: fonts + the fumadocs
 * stylesheet. Theme follows the reader (tokens.css color-scheme); the
 * fumadocs island renders all chrome.
 */
import "@fontsource/instrument-serif";
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/fumadocs.css";

interface Props {
  title: string;
  description?: string;
  /** This page's Markdown twin, advertised to agents that prefer the source. */
  markdownHref?: string;
}

const { title, description, markdownHref } = Astro.props;
---

<!doctype html>
<html lang="en" suppressHydrationWarning>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Discovery for agents: the Markdown source of this page, and the index
        of every page. Advertised in the head so a crawler finds them without
        being told, which is the whole reason the routes exist. */}
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
